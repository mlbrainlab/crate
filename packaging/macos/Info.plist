<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Crate.app's Info.plist; scripts/package-macos.sh fills in @VERSION@.
     Document types: the same extensions as the Windows installer
     (packaging/windows/crate.iss). Types macOS already knows (zip, tar, gz,
     bz2) rank "Alternate", so Crate shows in Open With without taking them
     from Archive Utility; the rest rank "Default" and are declared below. -->
