// The UI language's direction and font. "default:LTR" is translated as
// "default:RTL" in right-to-left languages (GTK's convention), so every
// window follows the bundled translation Slint has selected.
export global Locale {
    out property <bool> rtl: @tr("default:LTR") == "default:RTL";
    // For text that should start at the reading edge.
    out property <TextHorizontalAlignment> start: rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    out property <TextHorizontalAlignment> end: rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
    // macOS uses its own fonts (San Francisco, SF Arabic); elsewhere the
    // bundled ones. "Crate Arabic" (IBM Plex Sans Arabic) has its own Latin
    // letters too.
    in property <bool> system-fonts;
    out property <string> latin-font: system-fonts ? "System Font" : "Crate Inter";
    out property <string> font: rtl ? (system-fonts ? "SF Arabic" : "Crate Arabic") : latin-font;
}
