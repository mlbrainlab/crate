// The window for one archive, in two densities: the mini view (what a
// double-click opens) and the full view (Ctrl+Enter or the expand button).
// Both read ArchiveUi; the dialogs sit on top of either.
import { Tokens } from "tokens.slint";
import { Locale } from "locale.slint";
import { ArchiveUi } from "state.slint";
import { MiniBody } from "mini-view.slint";
import { FullBody } from "full-view.slint";
import { AddDialog, ClosePrompt, DeleteDialog, DonePopup, EncodingPicker, ErrorPopup, NameDialog, PasswordDialog, Toast, UpdatePrompt } from "overlays.slint";
import { ConflictDialog, ExtractDialog } from "extract-dialog.slint";
import { CaseClashDialog, NameFixDialog } from "name-dialogs.slint";
import { PreviewPanel } from "preview.slint";
import { ConvertDialog, PropertiesDialog } from "properties.slint";
import { ShortcutsSheet, ShortcutsUi } from "shortcuts.slint";

export component ArchiveWindow inherits Window {
    in property <bool> custom-frame;
    // macOS: the menus in the screen's menu bar.
    in property <bool> native-menu;

    title: ArchiveUi.archive-name == "" ? @tr("Crate") : @tr("{} — Crate", ArchiveUi.archive-name);
    icon: @image-url("../../assets/icons/png/crate-256.png");
    preferred-width: 520px;
    preferred-height: 620px;
    min-width: ArchiveUi.full ? 720px : 420px;
    min-height: 480px;
    no-frame: custom-frame;
    background: Tokens.bg;
    default-font-family: Locale.font;
    default-font-size: 14px;
    default-font-weight: 500;
    forward-focus: keys;

    property <bool> ready: ArchiveUi.status == "ready";
    property <bool> overlay: ArchiveUi.show-picker || ArchiveUi.show-password || ArchiveUi.show-error || ArchiveUi.show-done || ArchiveUi.ex-show || ArchiveUi.conflict-show || ArchiveUi.nf-show || ArchiveUi.cc-show || ArchiveUi.pv-show || ArchiveUi.name-show || ArchiveUi.delete-show || ArchiveUi.add-show || ArchiveUi.upd-show || ArchiveUi.close-show || ArchiveUi.pr-show || ArchiveUi.cv-show;
    // What the list keys need: an archive on screen and nothing on top.
    property <bool> idle: ready && !overlay && !ShortcutsUi.show;
    property <bool> editable: idle && ArchiveUi.full && ArchiveUi.can-edit && !ArchiveUi.busy;

    // macOS menu bar. Each item does what its key does below, when the key
    // would. A menu shortcut fires before the focused field sees the key, so
    // keys that text fields use (⌘A, Space, ⌘⌫, Return) stay with the key
    // handler and their items have none.
    if native-menu: MenuBar {
        Menu {
            title: @tr("Crate");
            MenuItem { title: @tr("Preferences"); shortcut: @keys(Control + ","); enabled: idle; activated => { ArchiveUi.open-prefs(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Quit"); shortcut: @keys(Control + Q); enabled: !overlay; activated => { ArchiveUi.close-window(); } }
        }
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("Close window"); shortcut: @keys(Control + W); enabled: !overlay; activated => { ArchiveUi.close-window(); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: @tr("Select all"); enabled: idle; activated => { ArchiveUi.select-all(); } }
            MenuItem { title: @tr("Filter / search"); shortcut: @keys(Control + F); enabled: idle; activated => { ArchiveUi.focus-search += 1; } }
            MenuSeparator {}
            MenuItem { title: @tr("Add files"); shortcut: @keys(Control + Shift + A); enabled: editable; activated => { ArchiveUi.add-files(); } }
            MenuItem { title: @tr("New folder"); shortcut: @keys(Control + Shift + N); enabled: editable; activated => { ArchiveUi.new-folder(); } }
            MenuItem { title: @tr("Rename"); enabled: editable; activated => { ArchiveUi.rename-current(); } }
            MenuItem { title: @tr("Delete from archive"); enabled: editable && ArchiveUi.selected-count > 0; activated => { ArchiveUi.delete-selected(); } }
        }
        Menu {
            title: @tr("Archive");
            MenuItem { title: @tr("Extract all"); shortcut: @keys(Control + E); enabled: idle && !ArchiveUi.busy; activated => { ArchiveUi.extract-all(); } }
            MenuItem { title: @tr("Extract selected"); shortcut: @keys(Control + Shift + E); enabled: idle && !ArchiveUi.busy && ArchiveUi.selected-count > 0; activated => { ArchiveUi.extract(); } }
            MenuItem {
                title: @tr("Test integrity");
                shortcut: @keys(Control + T);
                enabled: idle && !ArchiveUi.busy && ArchiveUi.test-state != 1;
                activated => {
                    if !ArchiveUi.full { ArchiveUi.open-properties(); ArchiveUi.pr-open-tab(1); }
                    ArchiveUi.test-archive();
                }
            }
            MenuSeparator {}
            MenuItem { title: @tr("Properties"); shortcut: @keys(Control + I); enabled: idle; activated => { ArchiveUi.open-properties(); } }
        }
        Menu {
            title: @tr("View");
            MenuItem { title: @tr("Mini ↔ full view"); shortcut: @keys(Control + Return); enabled: idle; activated => { ArchiveUi.toggle-full(); } }
            MenuItem { title: @tr("List / grid view"); shortcut: @keys(Control + G); enabled: idle && ArchiveUi.full; activated => { ArchiveUi.set-grid(!ArchiveUi.grid); } }
            MenuItem { title: @tr("Toggle sidebar"); enabled: idle && ArchiveUi.full; activated => { ArchiveUi.sidebar = !ArchiveUi.sidebar; } }
            MenuItem { title: @tr("Quick preview"); enabled: idle && ArchiveUi.full && ArchiveUi.preview-enabled; activated => { ArchiveUi.preview-current(); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: @tr("Keyboard shortcuts"); enabled: !ShortcutsUi.show; activated => { ShortcutsUi.open(); } }
        }
    }

    // Keyboard. Overlays first: Escape closes the top one. In the list:
    // arrows / Page Up / Page Down / Home / End move (Shift extends), Ctrl+A
    // selects all, Escape clears the selection. Alt+Up and Backspace go up
    // a folder. Mini view: Space toggles, Enter opens the folder under the
    // cursor or extracts. Full view: Enter opens, Space previews.
    // Ctrl+Enter switches views. The rest is listed in the shortcuts sheet
    // (Ctrl+?, app/src/shortcuts.rs), which must stay in step with this.
    keys := FocusScope {
        key-pressed(event) => {
            if ShortcutsUi.show {
                if event.text == Key.Escape || event.text == Key.F1 || ((event.text == "?" || event.text == "/") && event.modifiers.control) { ShortcutsUi.show = false; return accept; }
                return reject;
            }
            if ArchiveUi.pv-show {
                if event.text == Key.Escape || event.text == " " { ArchiveUi.pv-close(); return accept; }
                // Left and Right follow the reading direction.
                if event.text == Key.UpArrow || event.text == (Locale.rtl ? Key.RightArrow : Key.LeftArrow) { ArchiveUi.pv-step(-1); return accept; }
                if event.text == Key.DownArrow || event.text == (Locale.rtl ? Key.LeftArrow : Key.RightArrow) { ArchiveUi.pv-step(1); return accept; }
                return reject;
            }
            if event.text == Key.Escape {
                if ArchiveUi.cv-show { ArchiveUi.cv-cancel(); return accept; }
                if ArchiveUi.pr-show { ArchiveUi.pr-close(); return accept; }
                if ArchiveUi.close-show { ArchiveUi.close-cancel(); return accept; }
                if ArchiveUi.name-show { ArchiveUi.name-cancel(); return accept; }
                if ArchiveUi.delete-show { ArchiveUi.delete-cancel(); return accept; }
                if ArchiveUi.add-show { ArchiveUi.add-cancel(); return accept; }
                if ArchiveUi.conflict-show { ArchiveUi.conflict-answer(0, false); return accept; }
                if ArchiveUi.nf-show { ArchiveUi.nf-answer(3); return accept; }
                if ArchiveUi.cc-show { ArchiveUi.cc-answer(3, false); return accept; }
                if ArchiveUi.ex-show { ArchiveUi.ex-cancel(); return accept; }
                if ArchiveUi.show-picker { ArchiveUi.cancel-picker(); return accept; }
                if ArchiveUi.show-password { ArchiveUi.cancel-password(); return accept; }
                if ArchiveUi.show-error { ArchiveUi.dismiss-error(); return accept; }
                if ArchiveUi.show-done { ArchiveUi.back-to-archive(); return accept; }
                if ArchiveUi.selected-count > 0 { ArchiveUi.clear-selection(); return accept; }
                return reject;
            }
            // Work with or without an archive on screen.
            // Ctrl+? on any layout that has it, Ctrl+/ without Shift, or F1.
            if event.text == Key.F1 || ((event.text == "?" || event.text == "/") && event.modifiers.control) { ShortcutsUi.open(); return accept; }
            if (event.text == "w" || event.text == "W" || event.text == "q" || event.text == "Q") && event.modifiers.control && !overlay { ArchiveUi.close-window(); return accept; }
            if overlay || !ready {
                return reject;
            }
            if event.text == "," && event.modifiers.control { ArchiveUi.open-prefs(); return accept; }
            if event.text == Key.Return && event.modifiers.control { ArchiveUi.toggle-full(); return accept; }
            if event.text == Key.Return && event.modifiers.alt { ArchiveUi.open-properties(); return accept; }
            if (event.text == "e" || event.text == "E") && event.modifiers.control && !ArchiveUi.busy {
                // Ctrl+E everything, Ctrl+Shift+E the selection.
                if event.modifiers.shift { if ArchiveUi.selected-count > 0 { ArchiveUi.extract(); } } else { ArchiveUi.extract-all(); }
                return accept;
            }
            if (event.text == "t" || event.text == "T") && event.modifiers.control && !ArchiveUi.busy && ArchiveUi.test-state != 1 {
                // The mini view has no place for the result: show it in Properties.
                if !ArchiveUi.full { ArchiveUi.open-properties(); ArchiveUi.pr-open-tab(1); }
                ArchiveUi.test-archive();
                return accept;
            }
            if (event.text == "f" || event.text == "F") && event.modifiers.control { ArchiveUi.focus-search += 1; return accept; }
            if ArchiveUi.full {
                if (event.text == "g" || event.text == "G") && event.modifiers.control { ArchiveUi.set-grid(!ArchiveUi.grid); return accept; }
                if event.text == Key.F9 { ArchiveUi.sidebar = !ArchiveUi.sidebar; return accept; }
                if (event.text == "a" || event.text == "A") && event.modifiers.control && event.modifiers.shift && ArchiveUi.can-edit && !ArchiveUi.busy { ArchiveUi.add-files(); return accept; }
            }
            if event.text == Key.UpArrow && event.modifiers.alt { ArchiveUi.go-up(); return accept; }
            if ArchiveUi.full && ArchiveUi.grid {
                if event.text == Key.LeftArrow { ArchiveUi.step(Locale.rtl ? 1 : -1, event.modifiers.shift); return accept; }
                if event.text == Key.RightArrow { ArchiveUi.step(Locale.rtl ? -1 : 1, event.modifiers.shift); return accept; }
                if event.text == Key.UpArrow { ArchiveUi.step(-ArchiveUi.grid-columns, event.modifiers.shift); return accept; }
                if event.text == Key.DownArrow { ArchiveUi.step(ArchiveUi.grid-columns, event.modifiers.shift); return accept; }
            }
            if event.text == Key.UpArrow { ArchiveUi.step(-1, event.modifiers.shift); return accept; }
            if event.text == Key.DownArrow { ArchiveUi.step(1, event.modifiers.shift); return accept; }
            if event.text == Key.PageUp { ArchiveUi.step(-10, event.modifiers.shift); return accept; }
            if event.text == Key.PageDown { ArchiveUi.step(10, event.modifiers.shift); return accept; }
            if event.text == Key.Home { ArchiveUi.step(-1000000, event.modifiers.shift); return accept; }
            if event.text == Key.End { ArchiveUi.step(1000000, event.modifiers.shift); return accept; }
            if (event.text == "a" || event.text == "A") && event.modifiers.control { ArchiveUi.select-all(); return accept; }
            if ArchiveUi.full && ArchiveUi.can-edit && !ArchiveUi.busy {
                if event.text == Key.F2 { ArchiveUi.rename-current(); return accept; }
                if event.text == Key.Delete && ArchiveUi.selected-count > 0 { ArchiveUi.delete-selected(); return accept; }
                if (event.text == "n" || event.text == "N") && event.modifiers.control && event.modifiers.shift { ArchiveUi.new-folder(); return accept; }
            }
            if ArchiveUi.full {
                if event.text == " " && ArchiveUi.preview-enabled { ArchiveUi.preview-current(); return accept; }
                if event.text == Key.Backspace { ArchiveUi.go-up(); return accept; }
                if event.text == Key.Return && ArchiveUi.cursor >= 0 { ArchiveUi.row-activated(ArchiveUi.cursor); return accept; }
            } else {
                if event.text == " " && !event.modifiers.control { ArchiveUi.toggle-cursor(); return accept; }
                if event.text == Key.Backspace { ArchiveUi.go-up(); return accept; }
                // Kind 0 is a folder tile (model::Tile::Folder).
                if event.text == Key.Return && ArchiveUi.cursor >= 0 && ArchiveUi.cursor < ArchiveUi.rows.length && ArchiveUi.rows[ArchiveUi.cursor].kind == 0 { ArchiveUi.row-activated(ArchiveUi.cursor); return accept; }
                if event.text == Key.Return && !ArchiveUi.busy { ArchiveUi.extract(); return accept; }
            }
            reject
        }

        if !ArchiveUi.full: MiniBody {
            custom-frame: root.custom-frame;
            focus-keys => { keys.focus(); }
        }
        if ArchiveUi.full: FullBody {
            custom-frame: root.custom-frame;
            focus-keys => { keys.focus(); }
        }

        Toast {
            x: Locale.rtl ? parent.width - self.width - (18px) : 18px;
            width: root.width - 36px;
            y: root.height - (ArchiveUi.full ? 52px : 120px) - self.height;
        }
        if ArchiveUi.show-done: DonePopup { }
        if ArchiveUi.show-error: ErrorPopup { }
        if ArchiveUi.show-password: PasswordDialog { }
        if ArchiveUi.show-picker: EncodingPicker { }
        if ArchiveUi.ex-show: ExtractDialog { }
        if ArchiveUi.conflict-show: ConflictDialog { }
        if ArchiveUi.nf-show: NameFixDialog { }
        if ArchiveUi.cc-show: CaseClashDialog { }
        if ArchiveUi.pv-show: PreviewPanel { }
        if ArchiveUi.name-show: NameDialog { }
        if ArchiveUi.delete-show: DeleteDialog { }
        if ArchiveUi.add-show: AddDialog { }
        if ArchiveUi.upd-show: UpdatePrompt { }
        if ArchiveUi.pr-show: PropertiesDialog { }
        if ArchiveUi.cv-show: ConvertDialog { }
        if ArchiveUi.close-show: ClosePrompt { }
        if ShortcutsUi.show: ShortcutsSheet { }
    }

    // Clipboard: Slint's text input can copy, and Rust has no clipboard API
    // here, so Rust sets clip-text and bumps clip-serial.
    clip := TextInput { horizontal-alignment: Locale.start;
        width: 0;
        height: 0;
        opacity: 0;
        single-line: true;
    }
    property <int> clip-serial: ArchiveUi.clip-serial;
    changed clip-serial => {
        clip.text = ArchiveUi.clip-text;
        clip.select-all();
        clip.copy();
    }
}
