// "Extract files" (Extract.dc.html) and "File already exists"
// (Dialogs.dc.html).
import { Tokens } from "tokens.slint";
import { Locale } from "locale.slint";
import { Icon } from "icon.slint";
import { ArchiveUi } from "state.slint";
import { Button, Card, Checkbox, ClipText, DialogIcon, Icons, Scrim } from "parts.slint";

// One choice among a few, as a row of pills.
component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    border-radius: 8px;
    background: on ? Tokens.accent-soft : area.has-hover && enabled ? Tokens.surface-2 : Tokens.bg;
    border-width: 1px;
    border-color: on ? Tokens.accent.with-alpha(0.5) : Tokens.line;
    opacity: enabled ? 1 : 0.5;
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text { horizontal-alignment: Locale.start; text: root.text; color: root.on ? Tokens.accent-soft-ink : Tokens.ink; font-weight: root.on ? 600 : 500; vertical-alignment: center; }
    }
}

component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> text;
    in property <string> note;
    callback toggled;
    height: 30px;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    GridLayout {
        spacing: 10px;
        VerticalLayout { col: Locale.rtl ? ((root.note != "" ? 1 : 0) + 2) - 1 - (0) : 0; row: 0;
            alignment: center;
            Rectangle {
                width: 32px;
                height: 18px;
                border-radius: 9px;
                background: root.on ? Tokens.accent : Tokens.line;
                Rectangle {
                    x: Locale.rtl ? parent.width - self.width - (root.on ? parent.width - self.width - 2px : 2px) : root.on ? parent.width - self.width - 2px : 2px;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: white;
                    animate x { duration: 120ms; }
                }
            }
        }
        Text { horizontal-alignment: Locale.start; col: Locale.rtl ? ((root.note != "" ? 1 : 0) + 2) - 1 - (1) : 1; row: 0; text: root.text; color: Tokens.ink; vertical-alignment: center; }
        if root.note != "": Text { horizontal-alignment: Locale.start; col: Locale.rtl ? ((root.note != "" ? 1 : 0) + 2) - 1 - (2) : 2; row: 0; text: root.note; color: Tokens.ink-3; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
}

component Caption inherits Text {
    horizontal-alignment: Locale.start;
    color: Tokens.ink-3;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

component Field inherits Rectangle {
    in property <string> icon;
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted;
    height: 36px;
    border-radius: 9px;
    border-width: 1px;
    border-color: input.has-focus ? Tokens.accent : Tokens.line;
    background: Tokens.bg;
    GridLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.icon != "": Rectangle { col: Locale.rtl ? ((root.icon != "" ? 1 : 0) + 1) - 1 - (0) : 0; row: 0;
            width: 16px;
            Icon { size: 16; stroke: Tokens.ink-3; commands: root.icon; }
        }
        Rectangle { col: Locale.rtl ? ((root.icon != "" ? 1 : 0) + 1) - 1 - ((root.icon != "" ? 1 : 0)) : (root.icon != "" ? 1 : 0); row: 0;
            horizontal-stretch: 1;
            input := TextInput { horizontal-alignment: Locale.start;
                width: 100%;
                height: 100%;
                text <=> root.text;
                input-type: root.password ? InputType.password : InputType.text;
                color: Tokens.ink;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
            if root.text == "": Text { horizontal-alignment: Locale.start;
                x: Locale.rtl ? parent.width - self.width : 0;
                width: 100%;
                text: root.placeholder;
                color: Tokens.ink-3;
                vertical-alignment: center;
            }
        }
    }
}

export component ExtractDialog inherits Scrim {
    property <string> password;
    Card {
        width: min(560px, parent.width - 40px);
        height: min(layout.preferred-height, parent.height - 32px);
        clip: true;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 16px;
            GridLayout {
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 2 : 0; row: 0; tint: Tokens.accent; commands: Icons.download; }
                VerticalLayout { col: Locale.rtl ? 1 : 1; row: 0;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { horizontal-alignment: Locale.start; text: @tr("Extract files"); color: Tokens.ink; font-size: 16px; font-weight: 700; }
                    Text { horizontal-alignment: Locale.start; text: @tr("from {}", ArchiveUi.archive-name); color: Tokens.ink-3; font-size: 13px; overflow: elide; }
                }
                VerticalLayout { col: Locale.rtl ? 0 : 2; row: 0;
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: close-area.has-hover ? Tokens.surface-2 : transparent;
                        Icon { size: 14; stroke: Tokens.ink-2; commands: Icons.close; }
                        close-area := TouchArea { clicked => { ArchiveUi.ex-cancel(); } }
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                Caption { text: @tr("WHAT TO EXTRACT"); }
                HorizontalLayout {
                    alignment: Locale.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                    GridLayout {
                    spacing: 6px;
                        Segment { col: Locale.rtl ? 2 : 0; row: 0; text: @tr("Everything · {}", ArchiveUi.ex-all-count); on: ArchiveUi.ex-what == 0; clicked => { ArchiveUi.ex-set-what(0); } }
                        Segment { col: Locale.rtl ? 1 : 1; row: 0;
                            text: @tr("Selected · {n} item" | "Selected · {n} items" % ArchiveUi.ex-selected-count);
                            on: ArchiveUi.ex-what == 1;
                            enabled: ArchiveUi.ex-selected-count > 0;
                            clicked => { ArchiveUi.ex-set-what(1); }
                        }
                        Segment { col: Locale.rtl ? 0 : 2; row: 0; text: @tr("Matching pattern…"); on: ArchiveUi.ex-what == 2; clicked => { ArchiveUi.ex-set-what(2); } }
                    }
                }
                if ArchiveUi.ex-what == 2: GridLayout {
                    spacing: 10px;
                    Field { col: Locale.rtl ? 1 : 0; row: 0;
                        horizontal-stretch: 1;
                        icon: Icons.search;
                        text <=> ArchiveUi.ex-pattern;
                        placeholder: @tr("*.jpg, docs/*.pdf…");
                        edited(t) => { ArchiveUi.ex-pattern-edited(t); }
                    }
                    Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.ex-pattern-note; color: Tokens.ink-2; font-size: 13px; vertical-alignment: center; }
                }
            }

            VerticalLayout {
                spacing: 8px;
                Caption { text: @tr("DESTINATION"); }
                GridLayout {
                    spacing: 8px;
                    Field { col: Locale.rtl ? 1 : 0; row: 0;
                        horizontal-stretch: 1;
                        icon: Icons.folder;
                        text <=> ArchiveUi.ex-dest;
                        edited(t) => { ArchiveUi.ex-dest-edited(t); }
                    }
                    Button { col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Browse…"); clicked => { ArchiveUi.ex-browse(); } }
                }
                HorizontalLayout {
                    alignment: Locale.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                    GridLayout {
                    spacing: 6px;
                        Segment { col: Locale.rtl ? 2 : 0; row: 0; text: @tr("Next to archive"); height: 28px; clicked => { ArchiveUi.ex-quick-dest(0); } }
                        Segment { col: Locale.rtl ? 1 : 1; row: 0; text: @tr("Downloads"); height: 28px; clicked => { ArchiveUi.ex-quick-dest(1); } }
                        Segment { col: Locale.rtl ? 0 : 2; row: 0; text: @tr("Desktop"); height: 28px; clicked => { ArchiveUi.ex-quick-dest(2); } }
                    }
                }
            }

            VerticalLayout {
                spacing: 2px;
                Switch {
                    on: ArchiveUi.ex-create-folder;
                    text: @tr("Create a folder named “{}/”", ArchiveUi.ex-folder-name);
                    note: ArchiveUi.ex-smart ? @tr("the archive’s own top folder") : "";
                    toggled => { ArchiveUi.ex-toggle(0); }
                }
                Switch { on: ArchiveUi.ex-keep-structure; text: @tr("Keep folder structure"); toggled => { ArchiveUi.ex-toggle(1); } }
                Switch { on: ArchiveUi.ex-open-after; text: @tr("Open destination when done"); toggled => { ArchiveUi.ex-toggle(2); } }
                Switch { on: ArchiveUi.ex-trash-after; text: @tr("Move archive to Trash afterwards"); toggled => { ArchiveUi.ex-toggle(3); } }
            }

            VerticalLayout {
                spacing: 8px;
                Caption { text: @tr("IF A FILE ALREADY EXISTS"); }
                HorizontalLayout {
                    alignment: Locale.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                    GridLayout {
                    spacing: 6px;
                        for label[i] in [@tr("Ask"), @tr("Skip"), @tr("Overwrite"), @tr("Keep both"), @tr("Keep newer")]: Segment { col: Locale.rtl ? 4 - i : i; row: 0;
                            text: label;
                            on: ArchiveUi.ex-if-exists == i;
                            clicked => { ArchiveUi.ex-set-if-exists(i); }
                        }
                    }
                }
            }

            if ArchiveUi.ex-encrypted > 0: VerticalLayout {
                spacing: 8px;
                Caption { text: @tr("PASSWORD · {n} ENCRYPTED FILE" | "PASSWORD · {n} ENCRYPTED FILES" % ArchiveUi.ex-encrypted); }
                Field {
                    icon: Icons.lock;
                    password: true;
                    text <=> root.password;
                    accepted => { ArchiveUi.ex-confirm(root.password); }
                }
            }

            GridLayout {
                spacing: 10px;
                VerticalLayout { col: Locale.rtl ? 2 : 0; row: 0;
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 6px;
                    Text { horizontal-alignment: Locale.start;
                        text: @tr("{} needed · {} free", ArchiveUi.ex-needed, ArchiveUi.ex-free);
                        color: ArchiveUi.ex-space > 1 ? Tokens.danger : Tokens.ink-2;
                        font-size: 13px;
                    }
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Tokens.line;
                        Rectangle {
                            x: Locale.rtl ? parent.width - self.width : 0;
                            width: parent.width * min(1, max(0.02, ArchiveUi.ex-space));
                            border-radius: 2px;
                            background: ArchiveUi.ex-space > 1 ? Tokens.danger : ArchiveUi.ex-space > 0.8 ? Tokens.warning : Tokens.success;
                        }
                    }
                }
                Button { col: Locale.rtl ? 1 : 1; row: 0; text: @tr("Cancel"); clicked => { ArchiveUi.ex-cancel(); } }
                Button { col: Locale.rtl ? 0 : 2; row: 0;
                    text: ArchiveUi.ex-button;
                    icon: Icons.download;
                    primary: true;
                    enabled: ArchiveUi.ex-ready;
                    clicked => { ArchiveUi.ex-confirm(root.password); }
                }
            }
        }
    }
}

component SideCard inherits Rectangle {
    in property <string> caption;
    in property <string> name;
    in property <string> meta;
    in property <bool> highlight;
    border-radius: 10px;
    border-width: highlight ? 1.5px : 1px;
    border-color: highlight ? Tokens.accent : Tokens.line;
    background: highlight ? Tokens.accent-soft.mix(Tokens.bg, 0.4) : Tokens.bg;
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Caption { text: root.caption; color: root.highlight ? Tokens.accent-soft-ink : Tokens.ink-3; }
        ClipText { text: root.name; font-weight: 600; }
        Text { horizontal-alignment: Locale.start; text: root.meta; color: Tokens.ink-2; font-size: 13px; }
    }
}

export component ConflictDialog inherits Scrim {
    property <bool> for-all;
    Card {
        width: min(420px, parent.width - 40px);
        height: layout.preferred-height;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            GridLayout {
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 1 : 0; row: 0; tint: Tokens.warning; commands: "M9 9h12v12H9zM5 15V5a2 2 0 0 1 2-2h10"; }
                VerticalLayout { col: Locale.rtl ? 0 : 1; row: 0;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { horizontal-alignment: Locale.start; text: @tr("File already exists"); color: Tokens.ink; font-size: 16px; font-weight: 700; }
                    Text { horizontal-alignment: Locale.start; text: ArchiveUi.conflict-title; color: Tokens.ink-3; font-size: 13px; }
                }
            }
            GridLayout {
                spacing: 8px;
                SideCard { col: Locale.rtl ? 1 : 0; row: 0; caption: @tr("EXISTING"); name: ArchiveUi.conflict-name; meta: ArchiveUi.conflict-existing; horizontal-stretch: 1; }
                SideCard { col: Locale.rtl ? 0 : 1; row: 0;
                    caption: ArchiveUi.conflict-incoming-newer ? @tr("INCOMING · NEWER") : @tr("INCOMING");
                    name: ArchiveUi.conflict-name;
                    meta: ArchiveUi.conflict-incoming;
                    highlight: ArchiveUi.conflict-incoming-newer;
                    horizontal-stretch: 1;
                }
            }
            GridLayout {
                spacing: 8px;
                Checkbox { col: Locale.rtl ? 1 : 0; row: 0; checked: root.for-all; toggled => { root.for-all = !root.for-all; } }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0;
                    text: @tr("Do this for all remaining conflicts");
                    color: Tokens.ink;
                    vertical-alignment: center;
                    TouchArea { clicked => { root.for-all = !root.for-all; } }
                }
            }
            HorizontalLayout {
                alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
                GridLayout {
                spacing: 8px;
                    Button { col: Locale.rtl ? 2 : 0; row: 0; text: @tr("Skip"); clicked => { ArchiveUi.conflict-answer(0, root.for-all); } }
                    Button { col: Locale.rtl ? 1 : 1; row: 0; text: @tr("Keep both"); clicked => { ArchiveUi.conflict-answer(1, root.for-all); } }
                    Button { col: Locale.rtl ? 0 : 2; row: 0; text: @tr("Replace"); primary: true; clicked => { ArchiveUi.conflict-answer(2, root.for-all); } }
                }
            }
        }
    }
}
