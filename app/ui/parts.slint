// Small building blocks shared by the mini view, the full view and dialogs,
// drawn after the mockups' classes (.btn, .btn-p, .ib, .chip…).
import { Tokens } from "tokens.slint";
import { Icon } from "icon.slint";

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> fg;
    height: 20px;
    border-radius: 5px;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text { text: root.text; color: root.fg; font-size: 10px; font-weight: 600; vertical-alignment: center; letter-spacing: 0.2px; }
    }
}

// One line of user text (a file, folder or archive name) that never paints
// outside its box. Slint 1.18 doesn't elide right-to-left lines: no "…", and a
// name that starts in Arabic spills to the left over its neighbours (M5 Notes).
// Left-to-right names still elide as before.
export component ClipText {
    in property <string> text;
    in property <color> color: Tokens.ink;
    in property <length> font-size; // 0: the window's default
    in property <int> font-weight; // 0: the window's default
    in property <TextHorizontalAlignment> horizontal-alignment;
    preferred-width: label.preferred-width;
    min-height: label.preferred-height;
    preferred-height: label.preferred-height;
    Rectangle {
        clip: true;
        label := Text {
            width: 100%;
            height: 100%;
            text: root.text;
            color: root.color;
            font-size: root.font-size;
            font-weight: root.font-weight;
            horizontal-alignment: root.horizontal-alignment;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The colored square with an extension ("PDF") or a folder.
// kind: 0 folder, 1 PDF, 2 plain, 3 spreadsheet, 4 document, 5 image, 6 media, 7 archive, 8 code
export component FileTile inherits Rectangle {
    in property <int> kind;
    in property <string> ext;
    in property <length> size: 26px;
    width: size;
    height: size;
    border-radius: size * 0.27;
    background: kind == 0 ? Tokens.accent-soft
        : kind == 1 ? Tokens.danger.mix(Tokens.bg, 0.1)
        : kind == 3 ? Tokens.success.mix(Tokens.bg, 0.12)
        : kind == 4 || kind == 7 ? Tokens.accent-soft
        : kind == 5 ? Tokens.warning.mix(Tokens.bg, 0.12)
        : kind == 6 ? Tokens.crypto.mix(Tokens.bg, 0.12)
        : Tokens.surface-2;
    property <color> fg: kind == 0 ? Tokens.accent
        : kind == 1 ? Tokens.danger
        : kind == 3 ? Tokens.success
        : kind == 4 || kind == 7 ? Tokens.accent-soft-ink
        : kind == 5 ? Tokens.warning
        : kind == 6 ? Tokens.crypto
        : Tokens.ink-2;
    if kind == 0: Icon {
        size: root.size / 1px * 0.6;
        stroke: root.fg;
        commands: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
    }
    if kind != 0: Text {
        text: root.ext;
        font-size: root.size * 0.35;
        font-weight: 700;
        color: root.fg;
    }
}

// Plain or primary button, as in the mockups' .btn / .btn-p.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> quiet; // no border, muted text ("Close window")
    in property <bool> enabled: true;
    callback clicked;
    min-height: 36px;
    border-radius: 9px;
    border-width: primary || quiet || danger ? 0 : 1px;
    border-color: Tokens.line;
    property <color> fill: danger ? Tokens.danger : Tokens.accent;
    background: primary || danger ? (area.has-hover ? fill.mix(black, 0.88) : fill)
        : quiet ? (area.has-hover ? Tokens.surface-2 : transparent)
        : area.has-hover ? Tokens.surface-2 : Tokens.bg;
    opacity: enabled ? 1 : 0.5;
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Rectangle {
            width: 16px;
            Icon { size: 16; stroke: root.primary || root.danger ? white : Tokens.ink; commands: root.icon; }
        }
        Text {
            text: root.text;
            color: root.primary || root.danger ? white : root.quiet ? Tokens.ink-2 : Tokens.ink;
            font-weight: root.primary ? 600 : 500;
            vertical-alignment: center;
        }
    }
}

// Toolbar button: icon and label, no border (.tb).
export component ToolButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    border-radius: 7px;
    background: area.has-hover && enabled ? Tokens.line.mix(Tokens.bg, 0.6) : transparent;
    opacity: enabled ? 1 : 0.45;
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Rectangle {
            width: 16px;
            Icon { size: 16; stroke: Tokens.ink-2; commands: root.icon; }
        }
        Text { text: root.text; color: Tokens.ink-2; font-weight: 500; vertical-alignment: center; }
    }
}

// Square icon button (.ib).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 18px;
    in property <bool> pressed;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: pressed ? Tokens.bg : area.has-hover ? Tokens.line.mix(Tokens.bg, 0.6) : transparent;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon { size: root.icon-size / 1px; stroke: Tokens.ink-2; commands: root.icon; }
}

export component Link inherits Text {
    callback clicked;
    color: Tokens.accent-soft-ink;
    font-size: 13px;
    font-weight: 500;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Checkbox inherits Rectangle {
    in property <bool> checked;
    in property <bool> partial;
    callback toggled;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: checked || partial ? 0 : 1.5px;
    border-color: Tokens.ink-3;
    background: checked || partial ? Tokens.accent : Tokens.bg;
    if root.checked: Icon { size: 12; stroke: white; stroke-width: 2.5px; commands: "M5 12l5 5 9-10"; }
    if root.partial && !root.checked: Icon { size: 12; stroke: white; stroke-width: 2.5px; commands: "M6 12h12"; }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Dims the window behind a dialog and swallows clicks.
export component Scrim inherits Rectangle {
    background: black.with-alpha(Tokens.dark ? 0.5 : 0.36);
    TouchArea { }
}

export component Card inherits Rectangle {
    background: Tokens.dark ? Tokens.chrome : Tokens.bg;
    border-radius: 16px;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: black.with-alpha(0.25);
}

// Round tinted icon at the top of a dialog.
export component DialogIcon inherits Rectangle {
    in property <string> commands;
    in property <color> tint;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: tint.mix(Tokens.bg, 0.12);
    Icon { stroke: root.tint; commands: root.commands; }
}

// Icon paths used in several places (24 × 24 grid).
export global Icons {
    out property <string> folder: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
