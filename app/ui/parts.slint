    out property <string> list: "M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01";
    out property <string> grid: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z";
