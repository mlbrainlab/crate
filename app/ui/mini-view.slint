// Mini view (design/canvas/MiniView.dc.html, Linux variant): what opens when
// an archive is double-clicked. Summary, top-level list, one-click extract.
// Folders open in place, with a back row above the list.
import { ListView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Locale } from "locale.slint";
import { Icon } from "icon.slint";
import { WindowDragArea } from "header.slint";
import { ArchiveUi, Row } from "state.slint";
import { Chip, ClipText, FileTile, IconButton, Icons, Link } from "parts.slint";
import { EditTray, EncodingBanner, StatusPane } from "overlays.slint";

component RowItem inherits Rectangle {
    in property <Row> item;
    in property <bool> current; // the keyboard cursor is on this row
    callback pressed(/* ctrl */ bool, /* shift */ bool);
    callback activated;
    height: 38px;
    border-radius: 8px;
    background: item.selected ? Tokens.selection : area.has-hover ? Tokens.surface-2 : transparent;
    border-width: current ? 1px : 0;
    border-color: Tokens.accent.with-alpha(0.5);
    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.pressed(event.modifiers.control, event.modifiers.shift);
            }
        }
        double-clicked => { root.activated(); }
    }
    GridLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout { col: Locale.rtl ? 2 : 0; row: 0;
            alignment: center;
            FileTile { kind: item.kind; ext: item.ext; }
        }
        ClipText { col: Locale.rtl ? 1 : 1; row: 0; text: item.name; font-size: 14px; font-weight: 500; horizontal-stretch: 1; }
        Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 2; row: 0; text: item.meta; color: Tokens.ink-3; font-size: 13px; vertical-alignment: center; }
    }
}

// "‹ folder" above the list inside a folder: back up one level.
component BackRow inherits Rectangle {
    height: 32px;
    border-radius: 8px;
    background: area.has-hover ? Tokens.surface-2 : transparent;
    accessible-role: button;
    accessible-label: @tr("Back");
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { ArchiveUi.go-up(); }
    }
    GridLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Rectangle { col: Locale.rtl ? 1 : 0; row: 0;
            width: 16px;
            Icon { size: 16; stroke: Tokens.ink-2; commands: Icons.chevron-back; }
        }
        ClipText { col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.mini-folder; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
    }
}

// The window's search field, shared with the full view's filter.
export component SearchField inherits Rectangle {
    in property <string> placeholder;
    out property <bool> has-focus: input.has-focus;
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Tokens.accent : Tokens.line;
    background: Tokens.surface-2;
    public function focus-input() { input.focus(); }
    GridLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle { col: Locale.rtl ? 1 : 0; row: 0;
            width: 15px;
            Icon { size: 15; stroke: Tokens.ink-3; commands: Icons.search; }
        }
        Rectangle { col: Locale.rtl ? 0 : 1; row: 0;
            horizontal-stretch: 1;
            input := TextInput { horizontal-alignment: Locale.start;
                width: 100%;
                height: 100%;
                text <=> ArchiveUi.query;
                enabled: ArchiveUi.status == "ready";
                color: Tokens.ink;
                font-size: 14px;
                vertical-alignment: center;
                single-line: true;
                edited => { ArchiveUi.search(self.text); }
            }
            if ArchiveUi.query == "": Text { horizontal-alignment: Locale.start;
                x: Locale.rtl ? parent.width - self.width : 0;
                width: 100%;
                text: root.placeholder;
                color: Tokens.ink-3;
                vertical-alignment: center;
            }
        }
    }
}

// The primary button: fills with progress while extracting.
export component ExtractButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    height: 42px;
    border-radius: 10px;
    clip: true;
    background: ArchiveUi.busy ? Tokens.accent.mix(black, 0.55)
        : area.has-hover && enabled ? Tokens.accent.mix(black, 0.88)
        : Tokens.accent;
    opacity: enabled || ArchiveUi.busy ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.label;
    Rectangle {
        x: Locale.rtl ? parent.width - self.width : 0;
        width: ArchiveUi.busy ? parent.width * ArchiveUi.progress : 0;
        background: Tokens.accent;
        animate width { duration: 120ms; }
    }
    HorizontalLayout {
        alignment: center;
        GridLayout {
        spacing: 8px;
            Rectangle { col: Locale.rtl ? 1 : 0; row: 0;
                width: 18px;
                Icon { stroke: white; commands: Icons.download; }
            }
            Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: root.label; color: white; font-weight: 600; vertical-alignment: center; }
        }
    }
    area := TouchArea {
        enabled: root.enabled && !ArchiveUi.busy;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { ArchiveUi.extract(); }
    }
}

// Reading a huge tar: how much of the file has been read.
export component StreamBar inherits Rectangle {
    height: 3px;
    background: Tokens.line;
    Rectangle {
        x: Locale.rtl ? parent.width - self.width : 0;
        width: parent.width * ArchiveUi.stream-progress;
        background: Tokens.accent;
        animate width { duration: 100ms; }
    }
}

export component MiniBody inherits Rectangle {
    in property <bool> custom-frame;
    // Gives keyboard focus back to the window (rows take it on click).
    callback focus-keys;
    property <bool> ready: ArchiveUi.status == "ready";
    property <string> primary-label: ArchiveUi.busy && ArchiveUi.busy-text != "" ? ArchiveUi.busy-text
        : ArchiveUi.busy && ArchiveUi.opening != "" ? @tr("Opening “{}”…", ArchiveUi.opening)
        : ArchiveUi.busy ? (ArchiveUi.progress >= 0.999 ? @tr("Finishing…") : @tr("Extracting… {}%", Math.floor(ArchiveUi.progress * 100)))
        : ArchiveUi.selected-count > 0 ? @tr("Extract {n} selected" | "Extract {n} selected" % ArchiveUi.selected-count)
        : !ready || ArchiveUi.dest-name == "" ? @tr("Extract all")
        : @tr("Extract all to “{}/”", ArchiveUi.dest-name);
    background: Tokens.bg;

    VerticalLayout {
        // Header bar
        Rectangle {
            height: 46px;
            background: Tokens.chrome;
            WindowDragArea {
                drag-enabled: root.custom-frame;
                start-drag => { ArchiveUi.start-drag(); }
            }
            GridLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 6px;
                Rectangle { col: Locale.rtl ? 2 : 0; row: 0; width: 24px; }
                ClipText { col: Locale.rtl ? 1 : 1; row: 0; text: ArchiveUi.archive-name; font-weight: 600; horizontal-alignment: center; horizontal-stretch: 1; }
                VerticalLayout { col: Locale.rtl ? 0 : 2; row: 0;
                    alignment: center;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: close-area.has-hover ? Tokens.line : Tokens.line.mix(Tokens.chrome, 0.6);
                        Icon { size: 12; stroke: Tokens.ink-2; commands: Icons.close; }
                        close-area := TouchArea { clicked => { ArchiveUi.close-window(); } }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.line; }
        }
        if ArchiveUi.streaming: StreamBar { }

        // Summary
        GridLayout {
            padding: 18px;
            padding-bottom: 14px;
            spacing: 14px;
            Rectangle { col: Locale.rtl ? ((ArchiveUi.streaming ? 1 : 0) + 3) - 1 - (0) : 0; row: 0;
                width: 48px;
                height: 48px;
                border-radius: 13px;
                background: Tokens.accent;
                Icon { size: 24; stroke: white; commands: Icons.archive; }
            }
            VerticalLayout { col: Locale.rtl ? ((ArchiveUi.streaming ? 1 : 0) + 3) - 1 - (1) : 1; row: 0;
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                ClipText { text: ArchiveUi.archive-name; font-size: 15px; font-weight: 700; }
                Text { horizontal-alignment: Locale.start;
                    text: ArchiveUi.streaming ? ArchiveUi.stream-text
                        : ready ? ArchiveUi.summary
                        : ArchiveUi.status == "loading" ? @tr("Reading archive…") : " ";
                    color: Tokens.ink-2;
                    font-size: 13px;
                    overflow: elide;
                }
                HorizontalLayout {
                    alignment: Locale.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                    padding-top: 3px;
                    height: 23px;
                    GridLayout {
                    spacing: 5px;
                        if ArchiveUi.format-name != "": Chip { col: Locale.rtl ? ((ArchiveUi.format-name != "" ? 1 : 0) + (ArchiveUi.encrypted-count > 0 ? 1 : 0) + (ArchiveUi.encoding-chip != "" ? 1 : 0)) - 1 - (0) : 0; row: 0; text: ArchiveUi.format-name; background: Tokens.accent-soft; fg: Tokens.accent-soft-ink; }
                        if ArchiveUi.encrypted-count > 0: Chip { col: Locale.rtl ? ((ArchiveUi.format-name != "" ? 1 : 0) + (ArchiveUi.encrypted-count > 0 ? 1 : 0) + (ArchiveUi.encoding-chip != "" ? 1 : 0)) - 1 - ((ArchiveUi.format-name != "" ? 1 : 0)) : (ArchiveUi.format-name != "" ? 1 : 0); row: 0; text: @tr("{n} encrypted" | "{n} encrypted" % ArchiveUi.encrypted-count); background: Tokens.crypto.mix(Tokens.bg, 0.12); fg: Tokens.crypto; }
                        if ArchiveUi.encoding-chip != "": Chip { col: Locale.rtl ? ((ArchiveUi.format-name != "" ? 1 : 0) + (ArchiveUi.encrypted-count > 0 ? 1 : 0) + (ArchiveUi.encoding-chip != "" ? 1 : 0)) - 1 - ((ArchiveUi.format-name != "" ? 1 : 0) + (ArchiveUi.encrypted-count > 0 ? 1 : 0)) : (ArchiveUi.format-name != "" ? 1 : 0) + (ArchiveUi.encrypted-count > 0 ? 1 : 0); row: 0; text: ArchiveUi.encoding-chip; background: Tokens.success.mix(Tokens.bg, 0.12); fg: Tokens.success; }
                    }
                }
            }
            if ArchiveUi.streaming: VerticalLayout { col: Locale.rtl ? ((ArchiveUi.streaming ? 1 : 0) + 3) - 1 - (2) : 2; row: 0;
                alignment: center;
                Link { text: @tr("Stop reading"); clicked => { ArchiveUi.stop-reading(); } }
            }
            VerticalLayout { col: Locale.rtl ? ((ArchiveUi.streaming ? 1 : 0) + 3) - 1 - ((ArchiveUi.streaming ? 1 : 0) + 2) : (ArchiveUi.streaming ? 1 : 0) + 2; row: 0;
                alignment: center;
                IconButton {
                    width: 32px;
                    height: 32px;
                    icon: Icons.expand;
                    clicked => { ArchiveUi.toggle-full(); }
                }
            }
        }

        // Garbled-name banner
        if ArchiveUi.show-banner && ready: HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 10px;
            EncodingBanner { }
        }

        // Search
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 8px;
            SearchField {
                placeholder: !ready ? @tr("Search…") : @tr("Search {n} item…" | "Search {n} items…" % ArchiveUi.item-count);
            }
        }

        // Back row inside a folder
        if ready && ArchiveUi.mini-folder != "" && ArchiveUi.query == "": HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 2px;
            BackRow { }
        }

        // List, or why there isn't one
        Rectangle {
            vertical-stretch: 1;
            list := ListView {
                visible: ready;
                width: parent.width - 16px;
                x: Locale.rtl ? parent.width - self.width - (8px) : 8px;
                height: parent.height;
                for row[i] in ArchiveUi.rows: RowItem {
                    item: row;
                    current: i == ArchiveUi.cursor;
                    pressed(ctrl, shift) => {
                        root.focus-keys();
                        ArchiveUi.row-pressed(i, ctrl, shift);
                    }
                    activated => { ArchiveUi.row-activated(i); }
                }
            }
            if ready && ArchiveUi.rows.length == 0: Text {
                text: ArchiveUi.query == "" ? (ArchiveUi.streaming ? @tr("Reading archive…") : ArchiveUi.mini-folder != "" ? @tr("This folder is empty") : @tr("This archive is empty")) : @tr("Nothing matches “{}”", ArchiveUi.query);
                color: Tokens.ink-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if !ready: StatusPane { }
        }

        if ArchiveUi.edits-open > 0: EditTray { }
        // Footer
        Rectangle {
            background: Tokens.chrome;
            Rectangle { y: 0; height: 1px; background: Tokens.line; }
            VerticalLayout {
                padding: 18px;
                padding-top: 14px;
                padding-bottom: 16px;
                spacing: 10px;
                ExtractButton { label: root.primary-label; enabled: ready; }
                GridLayout {
                    spacing: 8px;
                    Rectangle { col: Locale.rtl ? ((ArchiveUi.busy ? 1 : 0) + (!ArchiveUi.busy && ready ? 1 : 0) + 2) - 1 - (0) : 0; row: 0;
                        width: 14px;
                        Icon { size: 14; stroke: Tokens.ink-2; commands: Icons.folder; }
                    }
                    Text { horizontal-alignment: Locale.start; col: Locale.rtl ? ((ArchiveUi.busy ? 1 : 0) + (!ArchiveUi.busy && ready ? 1 : 0) + 2) - 1 - (1) : 1; row: 0;
                        text: ArchiveUi.busy && ArchiveUi.current-file != "" ? ArchiveUi.current-file : ready ? ArchiveUi.dest-label : "";
                        color: Tokens.ink-2;
                        font-size: 13px;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if ArchiveUi.busy: Link { col: Locale.rtl ? ((ArchiveUi.busy ? 1 : 0) + (!ArchiveUi.busy && ready ? 1 : 0) + 2) - 1 - (2) : 2; row: 0; text: @tr("Cancel"); clicked => { ArchiveUi.cancel-extract(); } }
                    if !ArchiveUi.busy && ready: Link { col: Locale.rtl ? ((ArchiveUi.busy ? 1 : 0) + (!ArchiveUi.busy && ready ? 1 : 0) + 2) - 1 - ((ArchiveUi.busy ? 1 : 0) + 2) : (ArchiveUi.busy ? 1 : 0) + 2; row: 0; text: @tr("Extract to…"); clicked => { ArchiveUi.extract-dialog(); } }
                }
            }
        }
    }

    // Keep the keyboard cursor in view.
    property <int> cursor: ArchiveUi.cursor;
    changed cursor => {
        if cursor < 0 { return; }
        if cursor * 38px < -list.content-y {
            list.content-y = -cursor * 38px;
        } else if (cursor + 1) * 38px > -list.content-y + list.visible-height {
            list.content-y = -((cursor + 1) * 38px - list.visible-height);
        }
    }
}
