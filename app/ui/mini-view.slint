// Mini view (design/canvas/MiniView.dc.html, Linux variant): what opens when
// an archive is double-clicked. Summary, top-level list, one-click extract.
import { ListView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Icon } from "icon.slint";
import { WindowDragArea } from "header.slint";
import { ArchiveUi, Row } from "state.slint";
import { Chip, FileTile, IconButton, Icons, Link } from "parts.slint";
import { EncodingBanner, StatusPane } from "overlays.slint";

component RowItem inherits Rectangle {
    in property <Row> item;
    in property <bool> current; // the keyboard cursor is on this row
    callback pressed(/* ctrl */ bool, /* shift */ bool);
    callback activated;
    height: 38px;
    border-radius: 8px;
    background: item.selected ? Tokens.selection : area.has-hover ? Tokens.surface-2 : transparent;
    border-width: current ? 1px : 0;
    border-color: Tokens.accent.with-alpha(0.5);
    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.pressed(event.modifiers.control, event.modifiers.shift);
            }
        }
        double-clicked => { root.activated(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            FileTile { kind: item.kind; ext: item.ext; }
        }
        Text { text: item.name; color: Tokens.ink; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: item.meta; color: Tokens.ink-3; font-size: 12px; vertical-alignment: center; }
    }
}

// The window's search field, shared with the full view's filter.
export component SearchField inherits Rectangle {
    in property <string> placeholder;
    out property <bool> has-focus: input.has-focus;
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Tokens.accent : Tokens.line;
    background: Tokens.surface-2;
    public function focus-input() { input.focus(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: 15px;
            Icon { size: 15; stroke: Tokens.ink-3; commands: Icons.search; }
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> ArchiveUi.query;
                enabled: ArchiveUi.status == "ready";
                color: Tokens.ink;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                edited => { ArchiveUi.search(self.text); }
            }
            if ArchiveUi.query == "": Text {
                x: 0;
                width: 100%;
                text: root.placeholder;
                color: Tokens.ink-3;
                vertical-alignment: center;
            }
        }
    }
}

// The primary button: fills with progress while extracting.
export component ExtractButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    height: 42px;
    border-radius: 10px;
    clip: true;
    background: ArchiveUi.busy ? Tokens.accent.mix(black, 0.55)
        : area.has-hover && enabled ? Tokens.accent.mix(black, 0.88)
        : Tokens.accent;
    opacity: enabled || ArchiveUi.busy ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.label;
    Rectangle {
        x: 0;
        width: ArchiveUi.busy ? parent.width * ArchiveUi.progress : 0;
        background: Tokens.accent;
        animate width { duration: 120ms; }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Rectangle {
            width: 18px;
            Icon { stroke: white; commands: Icons.download; }
        }
        Text { text: root.label; color: white; font-weight: 600; vertical-alignment: center; }
    }
    area := TouchArea {
        enabled: root.enabled && !ArchiveUi.busy;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { ArchiveUi.extract(); }
    }
}

// Reading a huge tar: how much of the file has been read.
export component StreamBar inherits Rectangle {
    height: 3px;
    background: Tokens.line;
    Rectangle {
        x: 0;
        width: parent.width * ArchiveUi.stream-progress;
        background: Tokens.accent;
        animate width { duration: 100ms; }
    }
}

export component MiniBody inherits Rectangle {
    in property <bool> custom-frame;
    // Gives keyboard focus back to the window (rows take it on click).
    callback focus-keys;
    property <bool> ready: ArchiveUi.status == "ready";
    property <string> primary-label: ArchiveUi.busy && ArchiveUi.busy-text != "" ? ArchiveUi.busy-text
        : ArchiveUi.busy && ArchiveUi.opening != "" ? "Opening “" + ArchiveUi.opening + "”…"
        : ArchiveUi.busy ? (ArchiveUi.progress >= 0.999 ? "Finishing…" : "Extracting… " + Math.floor(ArchiveUi.progress * 100) + "%")
        : ArchiveUi.selected-count > 0 ? "Extract " + ArchiveUi.selected-count + " selected"
        : !ready || ArchiveUi.dest-name == "" ? "Extract all"
        : "Extract all to “" + ArchiveUi.dest-name + "/”";
    background: Tokens.bg;

    VerticalLayout {
        // Header bar
        Rectangle {
            height: 46px;
            background: Tokens.chrome;
            WindowDragArea {
                drag-enabled: root.custom-frame;
                start-drag => { ArchiveUi.start-drag(); }
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 6px;
                Rectangle { width: 24px; }
                Text { text: ArchiveUi.archive-name; color: Tokens.ink; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    y: 11px;
                    border-radius: 12px;
                    background: close-area.has-hover ? Tokens.line : Tokens.line.mix(Tokens.chrome, 0.6);
                    Icon { size: 12; stroke: Tokens.ink-2; commands: Icons.close; }
                    close-area := TouchArea { clicked => { ArchiveUi.close-window(); } }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.line; }
        }
        if ArchiveUi.streaming: StreamBar { }

        // Summary
        HorizontalLayout {
            padding: 18px;
            padding-bottom: 14px;
            spacing: 14px;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 13px;
                background: Tokens.accent;
                Icon { size: 24; stroke: white; commands: Icons.archive; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text { text: ArchiveUi.archive-name; color: Tokens.ink; font-size: 15px; font-weight: 700; overflow: elide; }
                Text {
                    text: ArchiveUi.streaming ? ArchiveUi.stream-text
                        : ready ? ArchiveUi.summary
                        : ArchiveUi.status == "loading" ? "Reading archive…" : " ";
                    color: Tokens.ink-2;
                    font-size: 12px;
                    overflow: elide;
                }
                HorizontalLayout {
                    padding-top: 3px;
                    spacing: 5px;
                    alignment: start;
                    height: 23px;
                    if ArchiveUi.format-name != "": Chip { text: ArchiveUi.format-name; background: Tokens.accent-soft; fg: Tokens.accent-soft-ink; }
                    if ArchiveUi.encrypted-count > 0: Chip { text: ArchiveUi.encrypted-count + " encrypted"; background: Tokens.crypto.mix(Tokens.bg, 0.12); fg: Tokens.crypto; }
                    if ArchiveUi.encoding-chip != "": Chip { text: ArchiveUi.encoding-chip; background: Tokens.success.mix(Tokens.bg, 0.12); fg: Tokens.success; }
                }
            }
            if ArchiveUi.streaming: VerticalLayout {
                alignment: center;
                Link { text: "Stop reading"; clicked => { ArchiveUi.stop-reading(); } }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    width: 32px;
                    height: 32px;
                    icon: Icons.expand;
                    clicked => { ArchiveUi.toggle-full(); }
                }
            }
        }

        // Garbled-name banner
        if ArchiveUi.show-banner && ready: HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 10px;
            EncodingBanner { }
        }

        // Search
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 8px;
            SearchField {
                placeholder: !ready ? "Search…" : ArchiveUi.item-count == 1 ? "Search 1 item…" : "Search " + ArchiveUi.item-count + " items…";
            }
        }

        // List, or why there isn't one
        Rectangle {
            vertical-stretch: 1;
            list := ListView {
                visible: ready;
                width: parent.width - 16px;
                x: 8px;
                height: parent.height;
                for row[i] in ArchiveUi.rows: RowItem {
                    item: row;
                    current: i == ArchiveUi.cursor;
                    pressed(ctrl, shift) => {
                        root.focus-keys();
                        ArchiveUi.row-pressed(i, ctrl, shift);
                    }
                    activated => { ArchiveUi.row-activated(i); }
                }
            }
            if ready && ArchiveUi.rows.length == 0: Text {
                text: ArchiveUi.query == "" ? (ArchiveUi.streaming ? "Reading archive…" : "This archive is empty") : "Nothing matches “" + ArchiveUi.query + "”";
                color: Tokens.ink-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if !ready: StatusPane { }
        }

        // Footer
        Rectangle {
            background: Tokens.chrome;
            Rectangle { y: 0; height: 1px; background: Tokens.line; }
            VerticalLayout {
                padding: 18px;
                padding-top: 14px;
                padding-bottom: 16px;
                spacing: 10px;
                ExtractButton { label: root.primary-label; enabled: ready; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 14px;
                        Icon { size: 14; stroke: Tokens.ink-2; commands: Icons.folder; }
                    }
                    Text {
                        text: ArchiveUi.busy && ArchiveUi.current-file != "" ? ArchiveUi.current-file : ready ? ArchiveUi.dest-label : "";
                        color: Tokens.ink-2;
                        font-size: 12px;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if ArchiveUi.busy: Link { text: "Cancel"; clicked => { ArchiveUi.cancel-extract(); } }
                    if !ArchiveUi.busy && ready: Link { text: "Extract to…"; clicked => { ArchiveUi.extract-dialog(); } }
                }
            }
        }
    }

    // Keep the keyboard cursor in view.
    property <int> cursor: ArchiveUi.cursor;
    changed cursor => {
        if cursor < 0 { return; }
        if cursor * 38px < -list.content-y {
            list.content-y = -cursor * 38px;
        } else if (cursor + 1) * 38px > -list.content-y + list.visible-height {
            list.content-y = -((cursor + 1) * 38px - list.visible-height);
        }
    }
}
