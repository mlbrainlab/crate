// Stroke icon on a 24 × 24 grid, drawn like the mockups' inline SVGs.
export component Icon inherits Path {
    in property <float> size: 18;
    width: size * 1px;
    height: size * 1px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 1.75px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}
