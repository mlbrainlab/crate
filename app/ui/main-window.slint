// Home (Main.dc.html, the parts M4 needs): start a new archive or open one.
// The New archive dialog (create-dialog.slint) opens on top of it.
import { Tokens } from "tokens.slint";
import { Locale } from "locale.slint";
import { Icon } from "icon.slint";
import { Header } from "header.slint";
import { Button, Icons, FocusRing, KeyFocus } from "parts.slint";
import { CreateDialog, CreateUi } from "create-dialog.slint";
import { FirstRun, FirstRunUi } from "first-run.slint";
import { ShortcutsSheet, ShortcutsUi } from "shortcuts.slint";
import { AboutSheet, AboutUi, SupportNudge } from "about.slint";
import { BatchSheet, BatchUi } from "batch.slint";
import { OpsPage, OpsUi } from "ops.slint";

component Tile inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> note;
    in property <string> keys;
    callback clicked;
    height: 116px;
    border-radius: 14px;
    border-width: 1px;
    border-color: area.has-hover ? Tokens.accent.with-alpha(0.5) : Tokens.line;
    background: area.has-hover ? Tokens.surface-2 : Tokens.bg;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    kf24 := KeyFocus { activate => { root.clicked(); } }
    FocusRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; on: kf24.has-focus; radius: 14px; }
    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        GridLayout {
            Rectangle { col: Locale.rtl ? 2 : 0; row: 0;
                width: 32px;
                height: 32px;
                border-radius: 9px;
                background: Tokens.accent-soft;
                Icon { stroke: Tokens.accent-soft-ink; commands: root.icon; }
            }
            Rectangle { col: Locale.rtl ? 1 : 1; row: 0; horizontal-stretch: 1; }
            Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 2; row: 0; text: root.keys; color: Tokens.ink-3; font-size: 11px; }
        }
        Text { horizontal-alignment: Locale.start; text: root.title; color: Tokens.ink; font-weight: 600; font-size: 14px; }
        Text { horizontal-alignment: Locale.start; text: root.note; color: Tokens.ink-2; font-size: 13px; wrap: word-wrap; }
    }
}

export component MainWindow inherits Window {
    in property <bool> custom-frame;
    in property <length> titlebar-inset;
    // macOS: the menus in the screen's menu bar.
    in property <bool> native-menu;
    // After a New archive: "Created photos.tar.zst · 812 MB".
    in property <string> created;
    callback start-drag;
    callback minimize;
    callback toggle-maximize;
    callback close-window;
    callback new-archive;
    callback open-archive;
    callback open-created;
    callback show-created;
    callback open-prefs;

    title: @tr("Crate");
    icon: @image-url("../../assets/icons/png/crate-256.png");
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 560px;
    no-frame: custom-frame;
    background: Tokens.bg;
    default-font-family: Locale.font;
    default-font-size: 14px;
    default-font-weight: 500;
    forward-focus: keys;

    // A sheet or dialog is on top: the keys below do nothing then.
    property <bool> modal: ShortcutsUi.show || AboutUi.show || OpsUi.show || BatchUi.show || FirstRunUi.show || CreateUi.show;

    // macOS menu bar: each item does what its key does below.
    if native-menu: MenuBar {
        Menu {
            title: @tr("Crate");
            MenuItem { title: @tr("About Crate"); enabled: !modal; activated => { AboutUi.open(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Preferences"); shortcut: @keys(Control + ","); enabled: !modal; activated => { root.open-prefs(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Quit"); shortcut: @keys(Control + Q); enabled: !modal; activated => { root.close-window(); } }
        }
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New archive"); shortcut: @keys(Control + N); enabled: !modal; activated => { root.new-archive(); } }
            MenuItem { title: @tr("Open archive"); shortcut: @keys(Control + O); enabled: !modal; activated => { root.open-archive(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Close window"); shortcut: @keys(Control + W); enabled: !modal; activated => { root.close-window(); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: @tr("Keyboard shortcuts"); enabled: !ShortcutsUi.show; activated => { ShortcutsUi.open(); } }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if ShortcutsUi.show {
                if event.text == Key.Escape || event.text == Key.F1 || ((event.text == "?" || event.text == "/") && event.modifiers.control) { ShortcutsUi.show = false; return accept; }
                return reject;
            }
            // Ctrl+? on any layout that has it, Ctrl+/ without Shift, or F1.
            if AboutUi.show {
                if event.text == Key.Escape { AboutUi.show = false; return accept; }
                return reject;
            }
            if OpsUi.show {
                if event.text == Key.Escape { OpsUi.show = false; return accept; }
                return reject;
            }
            if BatchUi.show {
                if event.text == Key.Escape {
                    if BatchUi.pw-row >= 0 { BatchUi.cancel-password(); return accept; }
                    if !BatchUi.started || BatchUi.finished { BatchUi.close(); return accept; }
                }
                return reject;
            }
            if event.text == Key.F1 || ((event.text == "?" || event.text == "/") && event.modifiers.control) { ShortcutsUi.open(); return accept; }
            if FirstRunUi.show {
                if event.text == Key.Escape { FirstRunUi.skip(); return accept; }
                if event.text == Key.Return { FirstRunUi.start(); return accept; }
                return reject;
            }
            if CreateUi.show {
                if event.text == Key.Escape { CreateUi.cancel(); return accept; }
                return reject;
            }
            if (event.text == "n" || event.text == "N") && event.modifiers.control { root.new-archive(); return accept; }
            if (event.text == "o" || event.text == "O") && event.modifiers.control { root.open-archive(); return accept; }
            if event.text == "," && event.modifiers.control { root.open-prefs(); return accept; }
            if (event.text == "w" || event.text == "W" || event.text == "q" || event.text == "Q") && event.modifiers.control { root.close-window(); return accept; }
            reject
        }

        VerticalLayout {
            Header {
                custom-frame: root.custom-frame;
                titlebar-inset: root.titlebar-inset;
                has-prefs: true;
                prefs => { root.open-prefs(); }
                shortcuts => { ShortcutsUi.open(); }
                about => { AboutUi.open(); }
                start-drag => { root.start-drag(); }
                minimize => { root.minimize(); }
                toggle-maximize => { root.toggle-maximize(); }
                close => { root.close-window(); }
            }
            Rectangle {
                vertical-stretch: 1;
                background: Tokens.surface-2;
                VerticalLayout {
                    alignment: center;
                    padding: 40px;
                    spacing: 20px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            border-radius: 18px;
                            background: Tokens.accent;
                            Icon { size: 32; stroke: white; commands: Icons.archive; }
                        }
                    }
                    Text { text: @tr("Compress files, or open an archive"); color: Tokens.ink; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                    Text {
                        text: @tr("Crate opens ZIP, 7z, RAR and TAR (gz, xz, zst, bz2), and makes ZIP, 7z and tar archives.");
                        color: Tokens.ink-2;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        GridLayout {
                        spacing: 14px;
                            Tile { col: Locale.rtl ? 1 : 0; row: 0;
                                width: 260px;
                                icon: "M12 5v14M5 12h14";
                                title: @tr("Compress files");
                                note: @tr("Pick files and folders, choose a format and level.");
                                keys: @tr("Ctrl N");
                                clicked => { root.new-archive(); }
                            }
                            Tile { col: Locale.rtl ? 0 : 1; row: 0;
                                width: 260px;
                                icon: Icons.folder;
                                title: @tr("Open an archive");
                                note: @tr("Browse, extract, edit, convert or test it.");
                                keys: @tr("Ctrl O");
                                clicked => { root.open-archive(); }
                            }
                        }
                    }
                    if root.created != "": HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 534px;
                            border-radius: 12px;
                            background: Tokens.success.mix(Tokens.bg, 0.1);
                            border-width: 1px;
                            border-color: Tokens.success.mix(Tokens.bg, 0.3);
                            GridLayout {
                                padding-left: Locale.rtl ? 10px : 14px;
                                padding-right: Locale.rtl ? 14px : 10px;
                                padding: 10px;
                                spacing: 10px;
                                Rectangle { col: Locale.rtl ? 3 : 0; row: 0;
                                    width: 18px;
                                    Icon { stroke: Tokens.success; commands: Icons.check; }
                                }
                                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 2 : 1; row: 0; text: root.created; color: Tokens.ink; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Button { col: Locale.rtl ? 1 : 2; row: 0; text: @tr("Show in folder"); min-height: 30px; clicked => { root.show-created(); } }
                                Button { col: Locale.rtl ? 0 : 3; row: 0; text: @tr("Open"); primary: true; min-height: 30px; clicked => { root.open-created(); } }
                            }
                        }
                    }
                    if AboutUi.nudge && AboutUi.has-support: HorizontalLayout {
                        alignment: center;
                        SupportNudge { width: 534px; }
                    }
                }
            }
        }

        if OpsUi.show: OpsPage { }
        if CreateUi.show: CreateDialog { }
        if FirstRunUi.show: FirstRun { }
        if ShortcutsUi.show: ShortcutsSheet { }
        if BatchUi.show: BatchSheet { }
        if AboutUi.show: AboutSheet { }
    }
}
