// Linux header bar (design/canvas/Main.dc.html). Windows keeps the native
// title bar, so the window controls only show with `custom-frame`; on macOS
// the traffic lights sit in this bar (`titlebar-inset` keeps clear of them).
import { Tokens } from "tokens.slint";
import { Locale } from "locale.slint";
import { OpsButton } from "ops.slint";
import { Icon } from "icon.slint";
import { IconButton, Icons, FocusRing, KeyFocus } from "parts.slint";

// Drag area for a custom title bar. A drag starts only once the pointer moves a
// few pixels with the button held, so clicks and double-clicks still arrive.
export component WindowDragArea inherits TouchArea {
    in property <bool> drag-enabled;
    callback start-drag;

    property <bool> pressing;
    property <length> press-x;
    property <length> press-y;

    pointer-event(event) => {
        if (event.button == PointerEventButton.left) {
            if (event.kind == PointerEventKind.down) {
                self.pressing = true;
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.up) {
                self.pressing = false;
            }
        }
    }
    moved => {
        if (self.drag-enabled && self.pressing
            && (abs(self.mouse-x - self.press-x) > 4px || abs(self.mouse-y - self.press-y) > 4px)) {
            self.pressing = false;
            self.start-drag();
        }
    }
}

export component WindowButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    callback clicked;

    width: 24px;
    height: 24px;
    border-radius: self.width / 2;
    background: area.has-hover ? Tokens.line : Tokens.line.mix(Tokens.chrome, 0.6);
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    Icon {
        size: 12;
        stroke: area.has-hover ? Tokens.ink : Tokens.ink-2;
        commands: root.icon;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    kf57 := KeyFocus { activate => { root.clicked(); } }
    FocusRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; on: kf57.has-focus; radius: 12px; }
}

export component Header inherits Rectangle {
    in property <string> title: @tr("Crate");
    in property <bool> custom-frame;
    // macOS: the traffic lights' width at the left edge.
    in property <length> titlebar-inset;
    // macOS: the title bar's height, which the bar takes on so its buttons
    // line up with the lights.
    in property <length> titlebar-height;
    in property <bool> has-prefs; // Home: a Preferences button at the end
    callback start-drag;
    callback minimize;
    callback toggle-maximize;
    callback close;
    callback prefs;
    callback shortcuts;
    callback about;

    height: root.titlebar-height > 0 ? root.titlebar-height : 56px;
    background: Tokens.chrome;

    // Drag region: the whole bar, under the buttons.
    WindowDragArea {
        drag-enabled: root.custom-frame || root.titlebar-inset > 0;
        start-drag => { root.start-drag(); }
        double-clicked => {
            if (root.custom-frame || root.titlebar-inset > 0) {
                root.toggle-maximize();
            }
        }
    }

    Text { horizontal-alignment: Locale.start;
        x: root.titlebar-inset;
        width: parent.width - root.titlebar-inset;
        text: root.title;
        color: Tokens.ink;
        font-size: 14px;
        font-weight: 600;
    }

    // .ib in the mockup's header ("Main menu"); for now Operations, Keyboard
    // shortcuts, Preferences and About, before the window buttons.
    if root.has-prefs: HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: (Locale.rtl ? self.inset : 0px) + root.titlebar-inset;
        padding-right: Locale.rtl ? 0px : self.inset;
        alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
        property <length> inset: root.custom-frame ? 12px + 3 * 24px + 2 * 8px + 14px : 12px;
        GridLayout {
            spacing: 4px;
            VerticalLayout {
                col: Locale.rtl ? 3 : 0; row: 0;
                alignment: center;
                OpsButton { }
            }
            VerticalLayout {
                col: Locale.rtl ? 2 : 1; row: 0;
                alignment: center;
                IconButton {
                    width: 32px;
                    height: 32px;
                    icon: Icons.keyboard;
                    label: @tr("Keyboard shortcuts");
                    clicked => { root.shortcuts(); }
                }
            }
            VerticalLayout {
                col: 2 - (Locale.rtl ? 1 : 0); row: 0;
                alignment: center;
                IconButton {
                    width: 32px;
                    height: 32px;
                    icon: Icons.gear;
                    label: @tr("Preferences");
                    clicked => { root.prefs(); }
                }
            }
            VerticalLayout {
                col: Locale.rtl ? 0 : 3; row: 0;
                alignment: center;
                IconButton {
                    width: 32px;
                    height: 32px;
                    icon: Icons.info;
                    label: @tr("About Crate");
                    clicked => { root.about(); }
                }
            }
        }
    }

    if root.custom-frame: HorizontalLayout {
        alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
        padding-left: Locale.rtl ? 12px : 0px;
        padding-right: Locale.rtl ? 0px : 12px;
        width: parent.width;
        height: parent.height;
        padding-top: (parent.height - 24px) / 2;
        padding-bottom: (parent.height - 24px) / 2;
        GridLayout {
        spacing: 8px;
            WindowButton { col: Locale.rtl ? 2 : 0; row: 0;
                label: @tr("Minimize");
                icon: "M5 12h14";
                clicked => { root.minimize(); }
            }
            WindowButton { col: Locale.rtl ? 1 : 1; row: 0;
                label: @tr("Maximize");
                icon: "M7 6h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z";
                clicked => { root.toggle-maximize(); }
            }
            WindowButton { col: Locale.rtl ? 0 : 2; row: 0;
                label: @tr("Close");
                icon: "M6 6l12 12M18 6 6 18";
                clicked => { root.close(); }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Tokens.line;
    }
}
