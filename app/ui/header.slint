// Linux header bar (design/canvas/Main.dc.html). Windows and macOS keep the
// native title bar (M7/M8), so the window controls only show with `custom-frame`.
import { Tokens } from "tokens.slint";
import { Icon } from "icon.slint";

// Drag area for a custom title bar. A drag starts only once the pointer moves a
// few pixels with the button held, so clicks and double-clicks still arrive.
export component WindowDragArea inherits TouchArea {
    in property <bool> drag-enabled;
    callback start-drag;

    property <bool> pressing;
    property <length> press-x;
    property <length> press-y;

    pointer-event(event) => {
        if (event.button == PointerEventButton.left) {
            if (event.kind == PointerEventKind.down) {
                self.pressing = true;
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.up) {
                self.pressing = false;
            }
        }
    }
    moved => {
        if (self.drag-enabled && self.pressing
            && (abs(self.mouse-x - self.press-x) > 4px || abs(self.mouse-y - self.press-y) > 4px)) {
            self.pressing = false;
            self.start-drag();
        }
    }
}

export component WindowButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    callback clicked;

    width: 24px;
    height: 24px;
    border-radius: self.width / 2;
    background: area.has-hover ? Tokens.line : Tokens.line.mix(Tokens.chrome, 0.6);
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    Icon {
        size: 12;
        stroke: area.has-hover ? Tokens.ink : Tokens.ink-2;
        commands: root.icon;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Header inherits Rectangle {
    in property <string> title: "Crate";
    in property <bool> custom-frame;
    callback start-drag;
    callback minimize;
    callback toggle-maximize;
    callback close;

    height: 56px;
    background: Tokens.chrome;

    // Drag region: the whole bar, under the buttons.
    WindowDragArea {
        drag-enabled: root.custom-frame;
        start-drag => { root.start-drag(); }
        double-clicked => {
            if (root.custom-frame) {
                root.toggle-maximize();
            }
        }
    }

    Text {
        text: root.title;
        color: Tokens.ink;
        font-size: 14px;
        font-weight: 600;
    }

    if root.custom-frame: HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-right: 12px;
        padding-top: (parent.height - 24px) / 2;
        padding-bottom: (parent.height - 24px) / 2;
        spacing: 8px;
        alignment: end;
        WindowButton {
            label: "Minimize";
            icon: "M5 12h14";
            clicked => { root.minimize(); }
        }
        WindowButton {
            label: "Maximize";
            icon: "M7 6h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z";
            clicked => { root.toggle-maximize(); }
        }
        WindowButton {
            label: "Close";
            icon: "M6 6l12 12M18 6 6 18";
            clicked => { root.close(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Tokens.line;
    }
}
