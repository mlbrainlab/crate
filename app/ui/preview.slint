// Quick preview (Preview.dc.html): Space on a file in the full view.
// Images, text with line numbers, hex for everything else.
import { ListView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Locale } from "locale.slint";
import { Icon } from "icon.slint";
import { ArchiveUi } from "state.slint";
import { Button, Card, ClipText, Icons, Scrim, FocusRing, KeyFocus } from "parts.slint";

component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: area.has-hover && enabled ? Tokens.surface-2 : transparent;
    opacity: enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    kf19 := KeyFocus { enabled: root.enabled; activate => { root.clicked(); } }
    FocusRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; on: kf19.has-focus; radius: 15px; }
    Icon { size: 16; stroke: Tokens.ink-2; commands: root.icon; }
}

export component PreviewPanel inherits Scrim {
    Card {
        width: min(960px, parent.width - 48px);
        height: min(720px, parent.height - 48px);
        clip: true;
        VerticalLayout {
            // Title bar
            Rectangle {
                height: 48px;
                GridLayout {
                    padding-left: Locale.rtl ? 10px : 16px;
                    padding-right: Locale.rtl ? 16px : 10px;
                    spacing: 8px;
                    ClipText { col: Locale.rtl ? 4 : 0; row: 0; text: ArchiveUi.pv-name; font-weight: 600; horizontal-stretch: 1; }
                    Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 3 : 1; row: 0; text: ArchiveUi.pv-language; color: Tokens.ink-3; font-size: 13px; vertical-alignment: center; }
                    VerticalLayout { col: Locale.rtl ? 2 : 2; row: 0;
                        alignment: center;
                        RoundButton { label: @tr("Previous"); icon: Icons.chevron-back; enabled: ArchiveUi.pv-can-prev; clicked => { ArchiveUi.pv-step(-1); } }
                    }
                    VerticalLayout { col: Locale.rtl ? 1 : 3; row: 0;
                        alignment: center;
                        RoundButton { label: @tr("Next"); icon: Icons.chevron-forward; enabled: ArchiveUi.pv-can-next; clicked => { ArchiveUi.pv-step(1); } }
                    }
                    VerticalLayout { col: Locale.rtl ? 0 : 4; row: 0;
                        alignment: center;
                        RoundButton { label: @tr("Close"); icon: Icons.close; clicked => { ArchiveUi.pv-close(); } }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.line; }
            }
            // Body
            Rectangle {
                vertical-stretch: 1;
                background: ArchiveUi.pv-kind == 1 ? Tokens.surface-2 : Tokens.bg;
                if ArchiveUi.pv-kind == 0: Text { horizontal-alignment: Locale.start; text: @tr("Reading…"); color: Tokens.ink-3; }
                if ArchiveUi.pv-kind == 4: Text {
                    width: parent.width - 64px;
                    text: ArchiveUi.pv-message;
                    color: Tokens.ink-2;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if ArchiveUi.pv-kind == 1: Image {
                    x: Locale.rtl ? parent.width - self.width - (16px) : 16px;
                    y: 16px;
                    width: parent.width - 32px;
                    height: parent.height - 32px;
                    source: ArchiveUi.pv-image;
                    image-fit: contain;
                }
                if ArchiveUi.pv-kind == 2 || ArchiveUi.pv-kind == 3: ListView {
                    for line[i] in ArchiveUi.pv-lines: GridLayout {
                        height: 20px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 14px;
                        if ArchiveUi.pv-kind == 2: Text { col: Locale.rtl ? ((ArchiveUi.pv-kind == 2 ? 1 : 0) + 1) - 1 - (0) : 0; row: 0;
                            width: 44px;
                            text: i + 1;
                            color: Tokens.ink-3;
                            font-size: 13px;
                            font-family: ArchiveUi.mono-font;
                            horizontal-alignment: Locale.end;
                            vertical-alignment: center;
                        }
                        Text { horizontal-alignment: Locale.start; col: Locale.rtl ? ((ArchiveUi.pv-kind == 2 ? 1 : 0) + 1) - 1 - ((ArchiveUi.pv-kind == 2 ? 1 : 0)) : (ArchiveUi.pv-kind == 2 ? 1 : 0); row: 0;
                            text: line;
                            color: Tokens.ink;
                            font-size: 13px;
                            font-family: ArchiveUi.mono-font;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
            // Footer
            Rectangle {
                height: 52px;
                Rectangle { y: 0; height: 1px; background: Tokens.line; }
                GridLayout {
                    padding-left: Locale.rtl ? 12px : 16px;
                    padding-right: Locale.rtl ? 16px : 12px;
                    spacing: 8px;
                    Text { horizontal-alignment: Locale.start; col: Locale.rtl ? ((ArchiveUi.pv-kind == 2 ? 1 : 0) + 3) - 1 - (0) : 0; row: 0; text: ArchiveUi.pv-info; color: Tokens.ink-2; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    if ArchiveUi.pv-kind == 2: VerticalLayout { col: Locale.rtl ? ((ArchiveUi.pv-kind == 2 ? 1 : 0) + 3) - 1 - (1) : 1; row: 0;
                        alignment: center;
                        horizontal-stretch: 0;
                        Button { text: @tr("Copy"); clicked => { ArchiveUi.pv-copy(); } }
                    }
                    VerticalLayout { col: Locale.rtl ? ((ArchiveUi.pv-kind == 2 ? 1 : 0) + 3) - 1 - ((ArchiveUi.pv-kind == 2 ? 1 : 0) + 1) : (ArchiveUi.pv-kind == 2 ? 1 : 0) + 1; row: 0;
                        alignment: center;
                        horizontal-stretch: 0;
                        Button { text: @tr("Open"); clicked => { ArchiveUi.pv-open(); } }
                    }
                    VerticalLayout { col: Locale.rtl ? ((ArchiveUi.pv-kind == 2 ? 1 : 0) + 3) - 1 - ((ArchiveUi.pv-kind == 2 ? 1 : 0) + 2) : (ArchiveUi.pv-kind == 2 ? 1 : 0) + 2; row: 0;
                        alignment: center;
                        horizontal-stretch: 0;
                        Button { text: @tr("Extract"); icon: Icons.download; primary: true; clicked => { ArchiveUi.pv-extract(); } }
                    }
                }
            }
        }
    }
}
