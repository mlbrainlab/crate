// Properties (Properties.dc.html) and Convert format (Dialogs.dc.html).
import { Tokens } from "tokens.slint";
import { Locale } from "locale.slint";
import { Icon } from "icon.slint";
import { ArchiveUi, Category } from "state.slint";
import { Button, Card, Checkbox, ClipText, DialogIcon, Icons, Scrim } from "parts.slint";

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 34px;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text { horizontal-alignment: Locale.start; text: root.text; color: root.on ? Tokens.accent-soft-ink : Tokens.ink-2; font-weight: root.on ? 600 : 500; vertical-alignment: center; }
    }
    Rectangle { y: parent.height - 2px; height: 2px; background: root.on ? Tokens.accent : transparent; }
}

component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> tint: Tokens.ink;
    spacing: 2px;
    Text { horizontal-alignment: Locale.start; text: root.label; color: Tokens.ink-3; font-size: 13px; }
    Text { horizontal-alignment: Locale.start; text: root.value; color: root.tint; font-size: 18px; font-weight: 700; }
}

component Fact inherits GridLayout {
    in property <string> label;
    in property <string> value;
    Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 1 : 0; row: 0; text: root.label; color: Tokens.ink-3; width: 120px; }
    Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: root.value; color: Tokens.ink; font-weight: 500; horizontal-stretch: 1; overflow: elide; }
}

component SumRow inherits GridLayout {
    in property <string> label;
    in property <string> value;
    callback copy;
    spacing: 10px;
    Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 2 : 0; row: 0; text: root.label; color: Tokens.ink-3; width: 70px; vertical-alignment: center; font-weight: 600; font-size: 13px; }
    Rectangle { col: Locale.rtl ? 1 : 1; row: 0;
        horizontal-stretch: 1;
        height: 32px;
        border-radius: 7px;
        background: Tokens.surface-2;
        Text { horizontal-alignment: Locale.start;
            x: Locale.rtl ? parent.width - self.width - (10px) : 10px;
            width: parent.width - 20px;
            text: root.value == "" ? "…" : root.value;
            color: Tokens.ink;
            font-size: 13px;
            font-family: ArchiveUi.mono-font;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle { col: Locale.rtl ? 0 : 2; row: 0;
        width: 32px;
        border-radius: 7px;
        background: area.has-hover ? Tokens.surface-2 : transparent;
        Icon { size: 15; stroke: Tokens.ink-2; commands: "M9 9h10v12H9zM5 15V3h10"; }
        area := TouchArea {
            enabled: root.value != "";
            mouse-cursor: pointer;
            clicked => { root.copy(); }
        }
    }
}

export component PropertiesDialog inherits Scrim {
    property <string> pasted;
    Card {
        width: min(600px, parent.width - 40px);
        height: min(560px, parent.height - 40px);
        clip: true;
        VerticalLayout {
            GridLayout {
                padding: 18px;
                padding-bottom: 8px;
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 3 : 0; row: 0; tint: Tokens.accent; commands: Icons.archive; }
                VerticalLayout { col: Locale.rtl ? 2 : 1; row: 0;
                    alignment: center;
                    horizontal-stretch: 1;
                    ClipText { text: ArchiveUi.archive-name; font-size: 16px; font-weight: 700; }
                    Text { horizontal-alignment: Locale.start; text: ArchiveUi.pr-location; color: Tokens.ink-3; font-size: 13px; overflow: elide; }
                }
                VerticalLayout { col: Locale.rtl ? 1 : 2; row: 0;
                    alignment: center;
                    Button { text: @tr("Show in folder"); icon: Icons.folder; min-height: 32px; clicked => { ArchiveUi.pr-show-folder(); } }
                }
                VerticalLayout { col: Locale.rtl ? 0 : 3; row: 0;
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: close-area.has-hover ? Tokens.surface-2 : transparent;
                        Icon { size: 14; stroke: Tokens.ink-2; commands: Icons.close; }
                        close-area := TouchArea { clicked => { ArchiveUi.pr-close(); } }
                    }
                }
            }
            HorizontalLayout {
                alignment: Locale.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                padding-left: Locale.rtl ? 0px : 12px;
                padding-right: Locale.rtl ? 12px : 0px;
                GridLayout {
                    Tab { col: Locale.rtl ? 2 : 0; row: 0; text: @tr("Overview"); on: ArchiveUi.pr-tab == 0; clicked => { ArchiveUi.pr-open-tab(0); } }
                    Tab { col: Locale.rtl ? 1 : 1; row: 0; text: @tr("Integrity"); on: ArchiveUi.pr-tab == 1; clicked => { ArchiveUi.pr-open-tab(1); } }
                    Tab { col: Locale.rtl ? 0 : 2; row: 0; text: @tr("Checksums"); on: ArchiveUi.pr-tab == 2; clicked => { ArchiveUi.pr-open-tab(2); } }
                }
            }
            Rectangle { height: 1px; background: Tokens.line; }

            if ArchiveUi.pr-tab == 0: VerticalLayout {
                vertical-stretch: 1;
                padding: 18px;
                spacing: 14px;
                GridLayout {
                    spacing: 12px;
                    Stat { col: Locale.rtl ? 3 : 0; row: 0; label: @tr("Original"); value: ArchiveUi.pr-original; horizontal-stretch: 1; }
                    Stat { col: Locale.rtl ? 2 : 1; row: 0; label: @tr("Compressed"); value: ArchiveUi.pr-compressed; horizontal-stretch: 1; }
                    Stat { col: Locale.rtl ? 1 : 2; row: 0; label: @tr("Saved"); value: ArchiveUi.pr-saved; tint: Tokens.success; horizontal-stretch: 1; }
                    Stat { col: Locale.rtl ? 0 : 3; row: 0; label: @tr("Items"); value: ArchiveUi.pr-items; horizontal-stretch: 2; }
                }
                Text { horizontal-alignment: Locale.start; text: @tr("WHAT’S INSIDE"); color: Tokens.ink-3; font-size: 11px; font-weight: 600; letter-spacing: 0.6px; }
                for c in ArchiveUi.pr-categories: GridLayout {
                    spacing: 10px;
                    Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 2 : 0; row: 0; text: c.name; color: Tokens.ink; width: 120px; vertical-alignment: center; }
                    VerticalLayout { col: Locale.rtl ? 1 : 1; row: 0;
                        alignment: center;
                        horizontal-stretch: 1;
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Tokens.line.mix(Tokens.bg, 0.6);
                            Rectangle {
                                x: Locale.rtl ? parent.width - self.width : 0;
                                width: parent.width * max(0.01, c.share);
                                border-radius: 3px;
                                background: Tokens.accent;
                            }
                        }
                    }
                    Text { col: Locale.rtl ? 0 : 2; row: 0;
                        text: c.saved >= 0 ? @tr("{} · saved {}%", c.size, Math.round(c.saved * 100)) : c.size;
                        color: Tokens.ink-2;
                        font-size: 13px;
                        width: 160px;
                        horizontal-alignment: Locale.end;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 1px; background: Tokens.line; }
                Fact { label: @tr("Format"); value: ArchiveUi.pr-format; }
                Fact { label: @tr("Method"); value: ArchiveUi.pr-method; }
                Fact { label: @tr("Encryption"); value: ArchiveUi.pr-encryption; }
                Fact { label: @tr("Solid"); value: ArchiveUi.pr-solid; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    Button { text: @tr("Convert format…"); icon: "M4 12a8 8 0 0 1 14-5.3L20 9M20 4v5h-5M20 12a8 8 0 0 1-14 5.3L4 15M4 20v-5h5"; clicked => { ArchiveUi.open-convert(); } }
                }
            }

            if ArchiveUi.pr-tab == 1: VerticalLayout {
                vertical-stretch: 1;
                padding: 18px;
                spacing: 14px;
                Rectangle {
                    border-radius: 12px;
                    background: ArchiveUi.test-state == 2 ? Tokens.success.mix(Tokens.bg, 0.1)
                        : ArchiveUi.test-state == 3 ? Tokens.danger.mix(Tokens.bg, 0.1)
                        : Tokens.surface-2;
                    GridLayout {
                        padding: 14px;
                        spacing: 12px;
                        DialogIcon { col: Locale.rtl ? 1 : 0; row: 0;
                            tint: ArchiveUi.test-state == 3 ? Tokens.danger : ArchiveUi.test-state == 2 ? Tokens.success : Tokens.ink-3;
                            commands: ArchiveUi.test-state == 3 ? Icons.warning : Icons.shield;
                        }
                        VerticalLayout { col: Locale.rtl ? 0 : 1; row: 0;
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { horizontal-alignment: Locale.start;
                                text: ArchiveUi.test-state == 0 ? @tr("Not tested yet") : ArchiveUi.test-status;
                                color: Tokens.ink;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            Text { horizontal-alignment: Locale.start; text: ArchiveUi.test-state == 0 ? @tr("Testing reads every file and checks its checksum. Nothing is written.") : ArchiveUi.pr-tested; color: Tokens.ink-2; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: ArchiveUi.test-state == 0 ? @tr("Test now") : @tr("Test again");
                        primary: true;
                        enabled: ArchiveUi.test-state != 1 && !ArchiveUi.busy;
                        clicked => { ArchiveUi.test-archive(); }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }

            if ArchiveUi.pr-tab == 2: VerticalLayout {
                vertical-stretch: 1;
                padding: 18px;
                spacing: 10px;
                Text { horizontal-alignment: Locale.start; text: ArchiveUi.pr-sums-busy ? @tr("Computing checksums of the archive file…") : @tr("Checksums of the archive file"); color: Tokens.ink-2; font-size: 13px; }
                SumRow { label: "SHA-256"; value: ArchiveUi.pr-sha256; copy => { ArchiveUi.pr-copy(0); } }
                SumRow { label: @tr("BLAKE3"); value: ArchiveUi.pr-blake3; copy => { ArchiveUi.pr-copy(1); } }
                SumRow { label: @tr("MD5"); value: ArchiveUi.pr-md5; copy => { ArchiveUi.pr-copy(2); } }
                Rectangle { height: 6px; }
                Rectangle {
                    height: 38px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: ArchiveUi.pr-verify-state == 1 ? Tokens.success : ArchiveUi.pr-verify-state == 2 ? Tokens.danger : input.has-focus ? Tokens.accent : Tokens.line;
                    GridLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Rectangle { col: Locale.rtl ? 1 : 0; row: 0;
                            width: 16px;
                            Icon { size: 16; stroke: Tokens.ink-3; commands: Icons.shield; }
                        }
                        Rectangle { col: Locale.rtl ? 0 : 1; row: 0;
                            horizontal-stretch: 1;
                            input := TextInput { horizontal-alignment: Locale.start;
                                width: 100%;
                                height: 100%;
                                text <=> root.pasted;
                                color: Tokens.ink;
                                font-family: ArchiveUi.mono-font;
                                vertical-alignment: center;
                                single-line: true;
                                edited => { ArchiveUi.pr-verify-edited(self.text); }
                            }
                            if root.pasted == "": Text { horizontal-alignment: Locale.start; x: Locale.rtl ? parent.width - self.width : 0; text: @tr("Paste a checksum to verify"); color: Tokens.ink-3; vertical-alignment: center; }
                        }
                    }
                }
                Text { horizontal-alignment: Locale.start;
                    text: ArchiveUi.pr-verify;
                    color: ArchiveUi.pr-verify-state == 1 ? Tokens.success : Tokens.danger;
                    font-size: 13px;
                    font-weight: 600;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

component FormatBox inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <bool> on;
    callback clicked;
    height: 60px;
    horizontal-stretch: 1;
    border-radius: 10px;
    border-width: on ? 1.5px : 1px;
    border-color: on ? Tokens.accent : Tokens.line;
    background: on ? Tokens.accent-soft.mix(Tokens.bg, 0.5) : area.has-hover ? Tokens.surface-2 : Tokens.bg;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        Text { text: root.title; color: root.on ? Tokens.accent-soft-ink : Tokens.ink; font-weight: 700; horizontal-alignment: center; }
        Text { text: root.note; color: Tokens.ink-2; font-size: 13px; horizontal-alignment: center; }
    }
}

export component ConvertDialog inherits Scrim {
    Card {
        width: min(460px, parent.width - 40px);
        height: layout.preferred-height;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            GridLayout {
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 1 : 0; row: 0; tint: Tokens.warning; commands: "M4 12a8 8 0 0 1 14-5.3L20 9M20 4v5h-5M20 12a8 8 0 0 1-14 5.3L4 15M4 20v-5h5"; }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Convert format"); color: Tokens.ink; font-size: 16px; font-weight: 700; vertical-alignment: center; }
            }
            GridLayout {
                spacing: 10px;
                FormatBox { col: Locale.rtl ? 2 : 0; row: 0; title: ArchiveUi.cv-from; note: ArchiveUi.cv-from-size; }
                VerticalLayout { col: Locale.rtl ? 1 : 1; row: 0;
                    alignment: center;
                    Icon { size: 18; stroke: Tokens.ink-3; commands: "M5 12h14M13 6l6 6-6 6"; }
                }
                FormatBox { col: Locale.rtl ? 0 : 2; row: 0; title: ArchiveUi.cv-format == 0 ? @tr("ZIP") : ArchiveUi.cv-format == 1 ? "7Z" : ArchiveUi.cv-format == 2 ? @tr("TAR.ZST") : ArchiveUi.cv-format == 3 ? @tr("TAR.GZ") : @tr("TAR.XZ"); note: ArchiveUi.cv-target; on: true; }
            }
            GridLayout {
                spacing: 6px;
                for f[i] in [@tr("ZIP"), "7Z", @tr("TAR.ZST"), @tr("TAR.GZ"), @tr("TAR.XZ")]: Rectangle { col: Locale.rtl ? ([@tr(""), "", @tr(""), @tr(""), @tr("")]).length - 1 - i : i; row: 0;
                    height: 28px;
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: i == ArchiveUi.cv-format ? Tokens.accent.with-alpha(0.5) : Tokens.line;
                    background: i == ArchiveUi.cv-format ? Tokens.accent-soft : Tokens.bg;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ArchiveUi.cv-set-format(i); }
                    }
                    Text { horizontal-alignment: Locale.start; text: f; color: i == ArchiveUi.cv-format ? Tokens.accent-soft-ink : Tokens.ink; font-size: 13px; font-weight: 600; }
                }
            }
            GridLayout {
                spacing: 8px;
                Checkbox { col: Locale.rtl ? 1 : 0; row: 0; checked: ArchiveUi.cv-keep; toggled => { ArchiveUi.cv-keep = !ArchiveUi.cv-keep; } }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0;
                    text: @tr("Keep the original archive");
                    color: Tokens.ink;
                    vertical-alignment: center;
                    TouchArea { clicked => { ArchiveUi.cv-keep = !ArchiveUi.cv-keep; } }
                }
            }
            HorizontalLayout {
                alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
                GridLayout {
                spacing: 8px;
                    Button { col: Locale.rtl ? 1 : 0; row: 0; text: @tr("Cancel"); clicked => { ArchiveUi.cv-cancel(); } }
                    Button { col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Convert"); primary: true; clicked => { ArchiveUi.cv-confirm(ArchiveUi.cv-keep); } }
                }
            }
        }
    }
}
