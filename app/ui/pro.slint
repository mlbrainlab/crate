// Crate Pro (design/canvas/Pro.dc.html): the upgrade sheet, entering a
// license key and the thank-you page, over Preferences. Rust fills it and
// does the activation off the UI thread (`app/src/prefs.rs`, `license.rs`).
import { Tokens } from "tokens.slint";
import { Locale } from "locale.slint";
import { Icon } from "icon.slint";
import { Button, Card, Icons, IconButton, Scrim } from "parts.slint";

export global ProUi {
    in-out property <bool> show;
    in-out property <int> page; // 0 upgrade, 1 enter a key, 2 thank you
    in property <bool> active; // a valid key is saved
    in property <string> since; // "Since Oct 31, 2026 · thank you for supporting Crate"
    in property <bool> can-buy; // this build knows the checkout link
    in property <string> price; // "$9"
    in-out property <string> key;
    in property <string> error;
    in property <bool> busy; // activating
    callback open(/* page */ int);
    callback buy;
    callback activate(string);
    callback cancel;
    callback remove;
}

export global ProIcons {
    out property <string> sparkle: "M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z";
    out property <string> window: "M6 4h12a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3zM3 9h18";
    out property <string> tiles: "M5 3h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM16 3h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM5 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2zM16 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-3a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2z";
    out property <string> heart: "M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z";
    out property <string> check: "M5 12l5 5 9-10";
    out property <string> back: "M15 18l-6-6 6-6";
    out property <string> alert: "M12 3a9 9 0 1 1 0 18a9 9 0 1 1 0-18zM12 8v4M12 16h.01";
}

// .feat: a tinted icon, a title and a line under it.
component Feature inherits GridLayout {
    in property <string> icon;
    in property <color> tint: Tokens.accent-soft-ink;
    in property <color> fill: Tokens.accent-soft;
    in property <string> title;
    in property <string> note;
    in property <length> text-width;
    spacing: 12px;
    VerticalLayout { col: Locale.rtl ? 1 : 0; row: 0;
        alignment: start;
        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: root.fill;
            Icon { stroke: root.tint; commands: root.icon; }
        }
    }
    VerticalLayout { col: Locale.rtl ? 0 : 1; row: 0;
        spacing: 2px;
        Text { text: root.title; color: Tokens.ink; font-size: 13px; font-weight: 600; horizontal-alignment: Locale.start; }
        Text { text: root.note; color: Tokens.ink-2; font-size: 12px; wrap: word-wrap; horizontal-alignment: Locale.start; width: root.text-width; }
    }
}

// The big rounded icon at the top of pages 0 and 2.
component Badge inherits HorizontalLayout {
    in property <string> icon;
    in property <color> fill;
    in property <color> tint;
    alignment: center;
    Rectangle {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: root.fill;
        Icon { size: 32; stroke: root.tint; commands: root.icon; }
    }
}

export component ProSheet inherits Scrim {
    property <length> card-width: min(440px, root.width - 32px);
    // The text column inside the padding (2 × 24), next to a feature's icon (34 + 12).
    property <length> inner: root.card-width - 48px;
    // A click outside the card closes it, unless a key is on its way.
    TouchArea { clicked => { if !ProUi.busy { ProUi.cancel(); } } }
    Card {
        width: root.card-width;
        height: min(layout.preferred-height, parent.height - 32px);
        clip: true;
        TouchArea { } // clicks on the card stay on it
        layout := VerticalLayout {
            // 0: what Pro is, Buy and "I have a license key".
            if ProUi.page == 0: VerticalLayout {
                VerticalLayout {
                    padding-top: 28px;
                    padding-bottom: 18px;
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 8px;
                    Badge { icon: ProIcons.sparkle; fill: Tokens.accent; tint: white; }
                    Text { text: @tr("Crate Pro"); color: Tokens.ink; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: @tr("New looks for Crate, and a way to support it. Everything else stays free."); color: Tokens.ink-2; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; width: root.card-width - 56px; }
                }
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-bottom: 18px;
                    spacing: 14px;
                    Feature { icon: ProIcons.window; title: @tr("Glass theme"); note: @tr("See-through windows that pick up your wallpaper, on Linux, Windows and macOS"); text-width: root.inner - 46px; }
                    Feature { icon: ProIcons.tiles; title: @tr("Four more app icons"); note: @tr("Pick the one you like for the Dock, taskbar or app menu"); text-width: root.inner - 46px; }
                    Feature { icon: ProIcons.heart; tint: Tokens.danger; fill: Tokens.danger.mix(Tokens.bg, 0.12); title: @tr("Keeps Crate going"); note: @tr("Crate is built by one developer, with no ads or tracking"); text-width: root.inner - 46px; }
                }
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-bottom: 20px;
                    spacing: 8px;
                    if ProUi.can-buy: Button { text: @tr("Buy Crate Pro · {}", ProUi.price); primary: true; min-height: 38px; clicked => { ProUi.buy(); } }
                    Button { text: @tr("I have a license key"); primary: !ProUi.can-buy; min-height: 38px; clicked => { ProUi.open(1); } }
                }
                Rectangle { height: 1px; background: Tokens.line.mix(Tokens.bg, 0.6); }
                VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 16px;
                    padding-left: 24px;
                    padding-right: 24px;
                    Text { text: @tr("One payment, every computer you use. Checkout by Lemon Squeezy."); color: Tokens.ink-3; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                }
            }

            // 1: the key field.
            if ProUi.page == 1: VerticalLayout {
                GridLayout {
                    padding-top: 20px;
                    padding-bottom: 6px;
                    padding-left: 20px;
                    padding-right: 24px;
                    spacing: 6px;
                    IconButton { col: Locale.rtl ? 1 : 0; row: 0; width: 30px; height: 30px; icon: ProIcons.back; label: @tr("Back"); clicked => { if !ProUi.busy { ProUi.open(0); } } }
                    Text { col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Enter your license key"); color: Tokens.ink; font-size: 17px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Locale.start; }
                }
                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 20px;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 10px;
                    Text { text: @tr("Paste the key from your Lemon Squeezy receipt, or a key that starts with CRATE-PRO."); color: Tokens.ink-2; font-size: 13px; wrap: word-wrap; horizontal-alignment: Locale.start; width: root.inner; }
                    Rectangle {
                        height: 38px;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: input.has-focus ? Tokens.accent : Tokens.line;
                        background: Tokens.bg;
                        // A key reads left to right, in Arabic too.
                        input := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: 100%;
                            text <=> ProUi.key;
                            enabled: !ProUi.busy;
                            single-line: true;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            color: Tokens.ink;
                            font-size: 13px;
                            accessible-label: @tr("License key");
                            accepted => { if ProUi.key != "" { ProUi.activate(ProUi.key); } }
                            init => { self.focus(); }
                        }
                    }
                    if ProUi.error != "": GridLayout {
                        spacing: 8px;
                        VerticalLayout { col: Locale.rtl ? 1 : 0; row: 0;
                            alignment: start;
                            padding-top: 1px;
                            Icon { size: 16; stroke: Tokens.danger; commands: ProIcons.alert; }
                        }
                        Text { col: Locale.rtl ? 0 : 1; row: 0; text: ProUi.error; color: Tokens.danger; font-size: 12px; wrap: word-wrap; horizontal-alignment: Locale.start; width: root.inner - 24px; accessible-role: text; }
                    }
                    HorizontalLayout {
                        alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
                        padding-top: 4px;
                        GridLayout {
                            spacing: 8px;
                            Button { col: Locale.rtl ? 1 : 0; row: 0; text: @tr("Cancel"); clicked => { ProUi.cancel(); } }
                            Button {
                                col: Locale.rtl ? 0 : 1; row: 0;
                                text: ProUi.busy ? @tr("Activating…") : @tr("Activate");
                                primary: true;
                                enabled: !ProUi.busy && ProUi.key != "";
                                clicked => { ProUi.activate(ProUi.key); }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Tokens.line.mix(Tokens.bg, 0.6); }
                VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 16px;
                    padding-left: 24px;
                    padding-right: 24px;
                    Text { text: @tr("Crate checks a Lemon Squeezy key once, online. After that the key is checked on this computer and nothing is sent."); color: Tokens.ink-3; font-size: 12px; wrap: word-wrap; horizontal-alignment: Locale.start; width: root.inner; }
                }
            }

            // 2: thank you.
            if ProUi.page == 2: VerticalLayout {
                VerticalLayout {
                    padding-top: 28px;
                    padding-bottom: 20px;
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 8px;
                    Badge { icon: ProIcons.check; fill: Tokens.success.mix(Tokens.bg, 0.12); tint: Tokens.success; }
                    Text { text: @tr("Thank you!"); color: Tokens.ink; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: @tr("Crate Pro is on. The Glass theme and the new icons arrive in Preferences → Appearance with the next updates."); color: Tokens.ink-2; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; width: root.card-width - 56px; }
                }
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: 20px;
                    Button { text: @tr("Done"); primary: true; min-width: 120px; clicked => { ProUi.show = false; } }
                }
            }
        }
    }
}
