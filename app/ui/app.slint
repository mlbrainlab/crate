// Root of the UI: bundled fonts and the windows the Rust side can create.
// Inter is compiled into the binary (assets/fonts/inter, OFL); nothing is loaded at runtime.
import "../../assets/fonts/inter/Inter-Regular.ttf";
import "../../assets/fonts/inter/Inter-Medium.ttf";
import "../../assets/fonts/inter/Inter-SemiBold.ttf";
import "../../assets/fonts/inter/Inter-Bold.ttf";

import { MainWindow } from "main-window.slint";
import { ArchiveWindow } from "archive-window.slint";
import { ArchiveUi } from "state.slint";
import { CreateUi } from "create-dialog.slint";

export { MainWindow, ArchiveWindow, ArchiveUi, CreateUi }

// Lets tests (and later the theme setting in M5) force light or dark.
export { Palette } from "std-widgets.slint";
