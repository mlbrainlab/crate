// Root of the UI: bundled fonts and the windows the Rust side can create.
// Inter is compiled into the binary (assets/fonts/inter, OFL); nothing is loaded at runtime.
import "../../assets/fonts/inter/Inter-Regular.ttf";
import "../../assets/fonts/inter/Inter-Medium.ttf";
import "../../assets/fonts/inter/Inter-SemiBold.ttf";
import "../../assets/fonts/inter/Inter-Bold.ttf";
// IBM Plex Sans Arabic as "Crate Arabic" (assets/fonts/crate-arabic, OFL), for the Arabic UI.
import "../../assets/fonts/crate-arabic/CrateArabic-Medium.ttf";
import "../../assets/fonts/crate-arabic/CrateArabic-SemiBold.ttf";

import { MainWindow } from "main-window.slint";
import { ArchiveWindow } from "archive-window.slint";
import { ArchiveUi } from "state.slint";
import { CreateUi } from "create-dialog.slint";
import { PrefsWindow, PrefsUi } from "prefs-window.slint";
import { ProUi } from "pro.slint";
import { FirstRunUi } from "first-run.slint";
import { Locale } from "locale.slint";
import { ShortcutsUi } from "shortcuts.slint";
import { AboutUi } from "about.slint";
import { BatchUi, BatchItem, BatchState } from "batch.slint";
import { OpsUi } from "ops.slint";

export { MainWindow, ArchiveWindow, ArchiveUi, CreateUi, PrefsWindow, PrefsUi, ProUi, FirstRunUi, Locale, ShortcutsUi, AboutUi, BatchUi, BatchItem, BatchState, OpsUi }

// The theme preference (and tests) force light or dark through it.
export { Palette } from "std-widgets.slint";
