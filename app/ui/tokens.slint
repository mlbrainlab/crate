// Color tokens from design/DESIGN.md (light / dark). Add new colors there first;
// don't use raw hex values anywhere else in the UI.
import { Palette } from "std-widgets.slint";

export global Tokens {
    // Follows the system color scheme, or the Theme preference (prefs.rs).
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <color> bg: dark ? #0f1115 : #ffffff;
    out property <color> surface-2: dark ? #12151b : #f7f8fa; // sidebar, details
    out property <color> chrome: dark ? #14171d : #fbfbfc; // header, footer
    out property <color> line: dark ? #232832 : #e6e8ec;
    out property <color> ink: dark ? #e7eaf0 : #0f172a;
    out property <color> ink-2: dark ? #a9b0bd : #475467;
    out property <color> ink-3: dark ? #8a93a3 : #667085;
    out property <color> accent: dark ? #4a65f0 : #3352e0; // button background
    out property <color> accent-soft: dark ? #1e2747 : #eef1fd;
    out property <color> accent-soft-ink: dark ? #afc0ff : #2a44c2; // text on accent-soft
    out property <color> selection: dark ? #1a2240 : #eef1fd;
    out property <color> success: dark ? #3dd68c : #0e7a4f;
    out property <color> warning: dark ? #f5a524 : #b45309;
    out property <color> danger: dark ? #ff8a80 : #c2261b;
    out property <color> crypto: dark ? #cdb4fa : #6b3fc4;
}
