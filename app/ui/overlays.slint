// Dialogs and toasts over an archive window, for both densities:
// done popup (MiniView.dc.html), error, password (Dialogs.dc.html),
// filename encoding picker (MiniViewRTL.dc.html).
import { ListView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Locale } from "locale.slint";
import { Icon } from "icon.slint";
import { ArchiveUi } from "state.slint";
import { Button, Card, Checkbox, ClipText, DialogIcon, Icons, Scrim } from "parts.slint";

// Place it with x / y / width from the parent.
export component Toast inherits Rectangle {
    visible: ArchiveUi.toast != "";
    height: 38px;
    border-radius: 10px;
    background: Tokens.ink;
    GridLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Rectangle { col: Locale.rtl ? 1 : 0; row: 0;
            width: 16px;
            Icon { size: 16; stroke: Tokens.success.mix(Tokens.bg, 0.6); commands: Icons.check; }
        }
        Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.toast; color: Tokens.bg; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
}

export component DonePopup inherits Scrim {
    Card {
        width: min(380px, parent.width - 48px);
        height: done-layout.preferred-height;
        done-layout := VerticalLayout {
            padding: 22px;
            padding-top: 24px;
            padding-bottom: 20px;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 26px;
                    background: Tokens.success.mix(Tokens.bg, 0.12);
                    Icon { size: 26; stroke: Tokens.success; stroke-width: 2px; commands: Icons.check; }
                }
            }
            Text { text: @tr("Files extracted"); color: Tokens.ink; font-size: 17px; font-weight: 700; horizontal-alignment: center; }
            Text { text: ArchiveUi.done-message; color: Tokens.ink-2; horizontal-alignment: center; wrap: word-wrap; }
            Text { text: @tr("to {}", ArchiveUi.done-folder); color: Tokens.ink; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
            if ArchiveUi.done-warning != "": Text { text: ArchiveUi.done-warning; color: Tokens.warning; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
            Rectangle { height: 2px; }
            Button {
                text: @tr("Open folder & close");
                icon: "M14 4h6v6M20 4 10 14M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5";
                primary: true;
                min-height: 42px;
                clicked => { ArchiveUi.open-folder-and-close(); }
            }
            GridLayout {
                spacing: 8px;
                Button { col: Locale.rtl ? 1 : 0; row: 0;
                    horizontal-stretch: 1;
                    min-height: 40px;
                    text: @tr("Open folder");
                    icon: Icons.folder;
                    clicked => { ArchiveUi.open-folder(); }
                }
                Button { col: Locale.rtl ? 0 : 1; row: 0;
                    horizontal-stretch: 1;
                    min-height: 40px;
                    text: @tr("Back to archive");
                    icon: Icons.arrow-back;
                    clicked => { ArchiveUi.back-to-archive(); }
                }
            }
            Button { text: @tr("Close window"); quiet: true; min-height: 34px; clicked => { ArchiveUi.close-window(); } }
        }
    }
}

export component ErrorPopup inherits Scrim {
    Card {
        width: min(400px, parent.width - 48px);
        height: error-layout.preferred-height;
        error-layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            GridLayout {
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 1 : 0; row: 0;
                    tint: ArchiveUi.error-kind == 2 ? Tokens.warning : Tokens.danger;
                    commands: ArchiveUi.error-kind == 3 ? Icons.lock
                        : ArchiveUi.error-kind == 2 ? "M4 6h16v12H4zM4 14h16M8 10h.01"
                        : Icons.warning;
                }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.error-title; color: Tokens.ink; font-size: 16px; font-weight: 700; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
            }
            Text { horizontal-alignment: Locale.start; text: ArchiveUi.error-message; color: Tokens.ink-2; wrap: word-wrap; }
            if ArchiveUi.error-detail != "": Rectangle {
                border-radius: 8px;
                background: Tokens.surface-2;
                height: detail.preferred-height + 16px;
                detail := Text { horizontal-alignment: Locale.start;
                    x: Locale.rtl ? parent.width - self.width - (10px) : 10px;
                    width: parent.width - 20px;
                    text: ArchiveUi.error-detail;
                    color: Tokens.ink-2;
                    font-size: 13px;
                    font-family: ArchiveUi.mono-font;
                    wrap: word-wrap;
                }
            }
            if ArchiveUi.error-kind != 3: HorizontalLayout {
                alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
                GridLayout {
                spacing: 8px;
                    if ArchiveUi.error-kind == 1 && ArchiveUi.error-can-force: Button { col: Locale.rtl ? ((ArchiveUi.error-kind == 1 && ArchiveUi.error-can-force ? 1 : 0) + (ArchiveUi.error-kind == 2 ? 1 : 0) + 1) - 1 - (0) : 0; row: 0; text: @tr("Extract anyway"); clicked => { ArchiveUi.force-extract(); } }
                    if ArchiveUi.error-kind == 2: Button { col: Locale.rtl ? ((ArchiveUi.error-kind == 1 && ArchiveUi.error-can-force ? 1 : 0) + (ArchiveUi.error-kind == 2 ? 1 : 0) + 1) - 1 - ((ArchiveUi.error-kind == 1 && ArchiveUi.error-can-force ? 1 : 0)) : (ArchiveUi.error-kind == 1 && ArchiveUi.error-can-force ? 1 : 0); row: 0; text: @tr("Choose another folder…"); clicked => { ArchiveUi.error-choose-folder(); } }
                    Button { col: Locale.rtl ? ((ArchiveUi.error-kind == 1 && ArchiveUi.error-can-force ? 1 : 0) + (ArchiveUi.error-kind == 2 ? 1 : 0) + 1) - 1 - ((ArchiveUi.error-kind == 1 && ArchiveUi.error-can-force ? 1 : 0) + (ArchiveUi.error-kind == 2 ? 1 : 0)) : (ArchiveUi.error-kind == 1 && ArchiveUi.error-can-force ? 1 : 0) + (ArchiveUi.error-kind == 2 ? 1 : 0); row: 0; text: ArchiveUi.error-kind == 2 ? @tr("Cancel") : @tr("OK"); primary: ArchiveUi.error-kind != 2; clicked => { ArchiveUi.dismiss-error(); } }
                }
            }
            // Can't write there: the way out first, then the rest.
            if ArchiveUi.error-kind == 3: VerticalLayout {
                spacing: 8px;
                Button { text: @tr("Extract to Downloads instead"); primary: true; clicked => { ArchiveUi.error-to-downloads(); } }
                GridLayout {
                    spacing: 8px;
                    Button { col: Locale.rtl ? 2 : 0; row: 0; text: @tr("Retry"); horizontal-stretch: 1; clicked => { ArchiveUi.error-retry(); } }
                    Button { col: Locale.rtl ? 1 : 1; row: 0; text: @tr("Choose folder…"); horizontal-stretch: 1; clicked => { ArchiveUi.error-choose-folder(); } }
                    Button { col: Locale.rtl ? 0 : 2; row: 0; text: @tr("Cancel"); horizontal-stretch: 1; clicked => { ArchiveUi.dismiss-error(); } }
                }
            }
        }
    }
}

export component PasswordDialog inherits Scrim {
    Card {
        width: min(360px, parent.width - 48px);
        height: pw-layout.preferred-height;
        pw-layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            GridLayout {
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 1 : 0; row: 0; tint: Tokens.crypto; commands: Icons.lock; }
                VerticalLayout { col: Locale.rtl ? 0 : 1; row: 0;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { horizontal-alignment: Locale.start; text: @tr("Password required"); color: Tokens.ink; font-size: 16px; font-weight: 700; }
                    ClipText { text: ArchiveUi.archive-name; color: Tokens.ink-3; font-size: 13px; }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Rectangle {
                    height: 38px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: ArchiveUi.password-error != "" ? Tokens.danger : pw-input.has-focus ? Tokens.accent : Tokens.line;
                    background: Tokens.bg;
                    GridLayout {
                        padding-left: Locale.rtl ? 10px : 12px;
                        padding-right: Locale.rtl ? 12px : 10px;
                        spacing: 10px;
                        pw-input := TextInput { horizontal-alignment: Locale.start; col: Locale.rtl ? 1 : 0; row: 0;
                            horizontal-stretch: 1;
                            input-type: eye.shown ? InputType.text : InputType.password;
                            color: Tokens.ink;
                            vertical-alignment: center;
                            single-line: true;
                            enabled: !ArchiveUi.password-checking;
                            init => { self.focus(); }
                            accepted => { ArchiveUi.unlock(self.text); }
                        }
                        eye := Rectangle { col: Locale.rtl ? 0 : 1; row: 0;
                            property <bool> shown;
                            width: 16px;
                            Icon {
                                size: 16;
                                stroke: Tokens.ink-2;
                                commands: eye.shown ? Icons.eye + "M3 3l18 18" : Icons.eye;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { eye.shown = !eye.shown; }
                            }
                        }
                    }
                }
                if ArchiveUi.password-error != "": Text { horizontal-alignment: Locale.start; text: ArchiveUi.password-error; color: Tokens.danger; font-size: 13px; font-weight: 500; }
                if ArchiveUi.password-checking: Text { horizontal-alignment: Locale.start; text: @tr("Checking…"); color: Tokens.ink-3; font-size: 13px; }
            }
            HorizontalLayout {
                alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
                GridLayout {
                spacing: 8px;
                    Button { col: Locale.rtl ? 1 : 0; row: 0; text: @tr("Cancel"); clicked => { ArchiveUi.cancel-password(); } }
                    Button { col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Unlock"); primary: true; enabled: !ArchiveUi.password-checking; clicked => { ArchiveUi.unlock(pw-input.text); } }
                }
            }
        }
    }
}

export component EncodingPicker inherits Scrim {
    Card {
        width: min(400px, parent.width - 48px);
        height: min(picker-layout.preferred-height, parent.height - 48px);
        picker-layout := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                Text { horizontal-alignment: Locale.start; text: @tr("Filename encoding"); color: Tokens.ink; font-size: 16px; font-weight: 700; }
                Text { horizontal-alignment: Locale.start; text: @tr("Older archives made on Windows store names in the system’s language. Pick the one that makes names readable."); color: Tokens.ink-2; wrap: word-wrap; }
            }
            Rectangle {
                border-width: 1px;
                border-color: Tokens.line;
                border-radius: 10px;
                min-height: 160px;
                vertical-stretch: 1;
                ListView {
                    x: Locale.rtl ? parent.width - self.width - (4px) : 4px;
                    width: parent.width - 8px;
                    for label[i] in ArchiveUi.codec-labels: Rectangle {
                        height: 34px;
                        border-radius: 7px;
                        background: i == ArchiveUi.codec-index ? Tokens.selection : codec-area.has-hover ? Tokens.surface-2 : transparent;
                        codec-area := TouchArea { clicked => { ArchiveUi.pick-codec(i); } }
                        GridLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            Text { horizontal-alignment: Locale.start; col: Locale.rtl ? ((i == ArchiveUi.codec-suggested ? 1 : 0) + 1) - 1 - (0) : 0; row: 0; text: label; color: Tokens.ink; font-weight: i == ArchiveUi.codec-index ? 600 : 400; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            if i == ArchiveUi.codec-suggested: Text { horizontal-alignment: Locale.start; col: Locale.rtl ? ((i == ArchiveUi.codec-suggested ? 1 : 0) + 1) - 1 - (1) : 1; row: 0; text: @tr("guessed"); color: Tokens.ink-3; font-size: 13px; vertical-alignment: center; }
                        }
                    }
                }
            }
            Rectangle {
                border-radius: 8px;
                background: Tokens.surface-2;
                VerticalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    spacing: 4px;
                    for name in ArchiveUi.codec-preview: ClipText { text: name; }
                }
            }
            HorizontalLayout {
                alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
                GridLayout {
                spacing: 8px;
                    Button { col: Locale.rtl ? 1 : 0; row: 0; text: @tr("Cancel"); clicked => { ArchiveUi.cancel-picker(); } }
                    Button { col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Apply"); primary: true; clicked => { ArchiveUi.apply-codec(); } }
                }
            }
        }
    }
}

// "File names may look garbled" with "Fix names".
export component EncodingBanner inherits Rectangle {
    border-radius: 10px;
    background: Tokens.warning.mix(Tokens.bg, 0.08);
    border-width: 1px;
    border-color: Tokens.warning.mix(Tokens.bg, 0.3);
    GridLayout {
        padding-left: Locale.rtl ? 10px : 12px;
        padding-right: Locale.rtl ? 12px : 10px;
        padding: 10px;
        spacing: 10px;
        Rectangle { col: Locale.rtl ? 2 : 0; row: 0;
            width: 18px;
            Icon { stroke: Tokens.warning; commands: Icons.warning; }
        }
        VerticalLayout { col: Locale.rtl ? 1 : 1; row: 0;
            horizontal-stretch: 1;
            alignment: center;
            Text { horizontal-alignment: Locale.start; text: @tr("File names may look garbled"); color: Tokens.ink; font-weight: 600; }
            Text { horizontal-alignment: Locale.start; text: ArchiveUi.banner-text; color: Tokens.ink-2; font-size: 13px; wrap: word-wrap; }
        }
        VerticalLayout { col: Locale.rtl ? 0 : 2; row: 0;
            alignment: center;
            Button { text: @tr("Fix names"); primary: true; min-height: 32px; clicked => { ArchiveUi.open-picker(); } }
        }
    }
}

// Why there is no list: loading, damaged, or locked by a password.
export component StatusPane inherits VerticalLayout {
    alignment: center;
    spacing: 10px;
    padding: 32px;
    if ArchiveUi.status == "loading": Text {
        text: @tr("Reading archive…");
        color: Tokens.ink-3;
        horizontal-alignment: center;
    }
    if ArchiveUi.status == "failed" || ArchiveUi.status == "locked": HorizontalLayout {
        alignment: center;
        DialogIcon {
            commands: ArchiveUi.status == "locked" ? Icons.lock : Icons.warning;
            tint: ArchiveUi.status == "locked" ? Tokens.crypto : Tokens.danger;
        }
    }
    if ArchiveUi.status == "failed" || ArchiveUi.status == "locked": Text {
        text: ArchiveUi.status == "locked" ? @tr("The file list is encrypted") : @tr("Can’t open this archive");
        color: Tokens.ink;
        font-size: 15px;
        font-weight: 700;
        horizontal-alignment: center;
    }
    if ArchiveUi.status == "failed" || ArchiveUi.status == "locked": Text {
        text: ArchiveUi.status-text;
        color: Tokens.ink-2;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if ArchiveUi.status == "locked": HorizontalLayout {
        alignment: center;
        Button { text: @tr("Enter password…"); primary: true; clicked => { ArchiveUi.ask-password(); } }
    }
}

// Rename / New folder: a name, checked as you type.
export component NameDialog inherits Scrim {
    Card {
        width: min(380px, parent.width - 48px);
        height: layout.preferred-height;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            GridLayout {
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 1 : 0; row: 0; tint: Tokens.accent; commands: "M4 20h4L19 9l-4-4L4 16z"; }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.name-title; color: Tokens.ink; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            }
            VerticalLayout {
                spacing: 6px;
                Text { horizontal-alignment: Locale.start; text: @tr("New name"); color: Tokens.ink-2; font-size: 13px; font-weight: 600; }
                Rectangle {
                    height: 38px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: ArchiveUi.name-error != "" ? Tokens.danger : input.has-focus ? Tokens.accent : Tokens.line;
                    background: Tokens.bg;
                    input := TextInput { horizontal-alignment: Locale.start;
                        x: Locale.rtl ? parent.width - self.width - (12px) : 12px;
                        width: parent.width - 24px;
                        height: 100%;
                        text <=> ArchiveUi.name-value;
                        color: Tokens.ink;
                        vertical-alignment: center;
                        single-line: true;
                        init => {
                            self.focus();
                            self.select-all();
                        }
                        edited => { ArchiveUi.name-edited(self.text); }
                        accepted => { ArchiveUi.name-confirm(self.text); }
                    }
                }
                if ArchiveUi.name-error != "": Text { horizontal-alignment: Locale.start; text: ArchiveUi.name-error; color: Tokens.danger; font-size: 13px; font-weight: 500; }
                if ArchiveUi.name-error == "": Text { horizontal-alignment: Locale.start; text: ArchiveUi.name-note; color: Tokens.ink-3; font-size: 13px; }
            }
            HorizontalLayout {
                alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
                GridLayout {
                spacing: 8px;
                    Button { col: Locale.rtl ? 1 : 0; row: 0; text: @tr("Cancel"); clicked => { ArchiveUi.name-cancel(); } }
                    Button { col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.name-button; primary: true; enabled: ArchiveUi.name-error == "" && ArchiveUi.name-value != ""; clicked => { ArchiveUi.name-confirm(ArchiveUi.name-value); } }
                }
            }
        }
    }
}

export component DeleteDialog inherits Scrim {
    Card {
        width: min(400px, parent.width - 48px);
        height: layout.preferred-height;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            GridLayout {
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 1 : 0; row: 0; tint: Tokens.danger; commands: "M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"; }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.delete-title; color: Tokens.ink; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
            }
            Text { horizontal-alignment: Locale.start; text: ArchiveUi.delete-text; color: Tokens.ink-2; wrap: word-wrap; }
            GridLayout {
                spacing: 8px;
                Checkbox { col: Locale.rtl ? 1 : 0; row: 0; checked: ArchiveUi.delete-backup; toggled => { ArchiveUi.delete-backup = !ArchiveUi.delete-backup; } }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0;
                    text: @tr("Keep a backup copy (.bak)");
                    color: Tokens.ink;
                    vertical-alignment: center;
                    TouchArea { clicked => { ArchiveUi.delete-backup = !ArchiveUi.delete-backup; } }
                }
            }
            HorizontalLayout {
                alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
                GridLayout {
                spacing: 8px;
                    Button { col: Locale.rtl ? 1 : 0; row: 0; text: @tr("Cancel"); clicked => { ArchiveUi.delete-cancel(); } }
                    Button { col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Delete"); danger: true; clicked => { ArchiveUi.delete-confirm(ArchiveUi.delete-backup); } }
                }
            }
        }
    }
}

export component AddDialog inherits Scrim {
    Card {
        width: min(400px, parent.width - 48px);
        height: layout.preferred-height;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            GridLayout {
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 1 : 0; row: 0; tint: Tokens.accent; commands: "M12 5v14M5 12h14"; }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.add-title; color: Tokens.ink; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
            }
            Text { horizontal-alignment: Locale.start; text: ArchiveUi.add-text; color: Tokens.ink-2; wrap: word-wrap; }
            if ArchiveUi.add-note != "": GridLayout {
                spacing: 8px;
                Icon { col: Locale.rtl ? 1 : 0; row: 0; size: 16; stroke: Tokens.warning; commands: Icons.warning; }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.add-note; color: Tokens.warning; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
            }
            HorizontalLayout {
                alignment: Locale.rtl ? LayoutAlignment.start : LayoutAlignment.end;
                GridLayout {
                spacing: 8px;
                    Button { col: Locale.rtl ? 1 : 0; row: 0; text: @tr("Cancel"); clicked => { ArchiveUi.add-cancel(); } }
                    Button { col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Add"); primary: true; clicked => { ArchiveUi.add-confirm(); } }
                }
            }
        }
    }
}

// Files opened from the archive and saved since: a bar above the footer.
export component EditTray inherits Rectangle {
    height: 44px;
    background: Tokens.accent-soft.mix(Tokens.bg, 0.6);
    Rectangle { y: 0; height: 1px; background: Tokens.line; }
    GridLayout {
        padding-left: Locale.rtl ? 12px : 18px;
        padding-right: Locale.rtl ? 18px : 12px;
        spacing: 10px;
        Rectangle { col: Locale.rtl ? ((ArchiveUi.edits-changed > 0 && !ArchiveUi.upd-read-only ? 1 : 0) + 2) - 1 - (0) : 0; row: 0;
            width: 16px;
            Icon { size: 16; stroke: Tokens.accent-soft-ink; commands: "M4 20h4L19 9l-4-4L4 16z"; }
        }
        Text { horizontal-alignment: Locale.start; col: Locale.rtl ? ((ArchiveUi.edits-changed > 0 && !ArchiveUi.upd-read-only ? 1 : 0) + 2) - 1 - (1) : 1; row: 0; text: ArchiveUi.edits-text; color: Tokens.accent-soft-ink; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if ArchiveUi.edits-changed > 0 && !ArchiveUi.upd-read-only: VerticalLayout { col: Locale.rtl ? ((ArchiveUi.edits-changed > 0 && !ArchiveUi.upd-read-only ? 1 : 0) + 2) - 1 - (2) : 2; row: 0;
            alignment: center;
            Button {
                text: @tr("Update archive ({n} file)" | "Update archive ({n} files)" % ArchiveUi.edits-changed);
                primary: true;
                min-height: 30px;
                enabled: !ArchiveUi.busy;
                clicked => { ArchiveUi.edits-update(); }
            }
        }
    }
}

export component UpdatePrompt inherits Scrim {
    Card {
        width: min(420px, parent.width - 48px);
        height: layout.preferred-height;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            GridLayout {
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 1 : 0; row: 0; tint: Tokens.accent; commands: "M4 12a8 8 0 0 1 14-5.3L20 9M20 4v5h-5M20 12a8 8 0 0 1-14 5.3L4 15M4 20v-5h5"; }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.upd-title; color: Tokens.ink; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
            }
            Text { horizontal-alignment: Locale.start; text: ArchiveUi.upd-text; color: Tokens.ink-2; wrap: word-wrap; }
            if !ArchiveUi.upd-read-only: GridLayout {
                spacing: 8px;
                Checkbox { col: Locale.rtl ? 1 : 0; row: 0; checked: ArchiveUi.upd-always; toggled => { ArchiveUi.upd-always = !ArchiveUi.upd-always; } }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0;
                    text: @tr("Always update without asking for this archive");
                    color: Tokens.ink;
                    vertical-alignment: center;
                    TouchArea { clicked => { ArchiveUi.upd-always = !ArchiveUi.upd-always; } }
                }
            }
            if !ArchiveUi.upd-read-only: Button { text: @tr("Update archive"); primary: true; min-height: 40px; clicked => { ArchiveUi.upd-update(); } }
            GridLayout {
                spacing: 8px;
                Button { col: Locale.rtl ? 1 : 0; row: 0; text: @tr("Save copy elsewhere…"); horizontal-stretch: 1; primary: ArchiveUi.upd-read-only; clicked => { ArchiveUi.upd-copy(); } }
                Button { col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Discard changes"); horizontal-stretch: 1; clicked => { ArchiveUi.upd-discard(); } }
            }
        }
    }
}

export component ClosePrompt inherits Scrim {
    Card {
        width: min(400px, parent.width - 48px);
        height: layout.preferred-height;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            GridLayout {
                spacing: 12px;
                DialogIcon { col: Locale.rtl ? 1 : 0; row: 0; tint: Tokens.warning; commands: Icons.warning; }
                Text { horizontal-alignment: Locale.start; col: Locale.rtl ? 0 : 1; row: 0; text: ArchiveUi.close-title; color: Tokens.ink; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
            }
            Text { horizontal-alignment: Locale.start; text: ArchiveUi.close-text; color: Tokens.ink-2; wrap: word-wrap; }
            if !ArchiveUi.upd-read-only: Button { text: @tr("Update and close"); primary: true; min-height: 40px; clicked => { ArchiveUi.close-update(); } }
            GridLayout {
                spacing: 8px;
                Button { col: Locale.rtl ? 1 : 0; row: 0; text: @tr("Close without saving"); horizontal-stretch: 1; danger: ArchiveUi.upd-read-only; clicked => { ArchiveUi.close-discard(); } }
                Button { col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Cancel"); horizontal-stretch: 1; clicked => { ArchiveUi.close-cancel(); } }
            }
        }
    }
}
